---
import { email, projects, socials } from './data';
---

<div class="notes-world">
  <header class="notes-top">
    <a href="#notes-top" class="notes-wordmark">TryRaisins’ field notes</a>
    <p>Software, systems, and the reasons behind them</p>
    <a href={`mailto:${email}`}>Write to me</a>
  </header>

  <main id="notes-top" class="notes-book">
    <aside class="notes-margin" aria-label="Notebook information">
      <p>No. 09</p>
      <p>Written from<br />Lagos, Nigeria</p>
      <p>Updated<br />September 2026</p>
      <span aria-hidden="true">↘</span>
    </aside>

    <div class="notes-pages">
      <section class="notes-opening" aria-labelledby="notes-title">
        <p class="notes-date">A note about making things</p>
        <h1 id="notes-title">I like software best when it disappears into a problem and leaves something useful behind.</h1>
        <div class="notes-opening-grid">
          <p>I’m TryRaisins, a software engineer in Lagos. I design the interface, work through the system underneath it, and stay until the product is genuinely usable.</p>
          <p class="notes-pencil">Six recent entries from the workbench follow. The margin tells you what I cared about.</p>
        </div>
      </section>

      <section class="notes-index" aria-labelledby="notes-work-title">
        <header>
          <p>Index of work</p>
          <h2 id="notes-work-title">What I made, and why it needed making.</h2>
        </header>

        <ol>
          {projects.map((project) => (
            <li>
              <div class="notes-entry-number">{project.number}<span>{project.year}</span></div>
              <a href={project.href} target="_blank" rel="noopener noreferrer" aria-label={`Read ${project.name} project`}>
                <span class="notes-entry-copy">
                  <span class="notes-entry-type">{project.type}</span>
                  <strong>{project.name}</strong>
                  <span>{project.description}</span>
                  <em>Open the project ↗</em>
                </span>
                <span class="notes-entry-image">
                  {project.cover ? <img src={project.cover.src} alt={project.coverAlt} loading="lazy" /> : <b aria-hidden="true">{project.monogram}</b>}
                </span>
              </a>
              <aside><span>Margin note</span>{project.note}</aside>
            </li>
          ))}
        </ol>
      </section>

      <footer class="notes-footer">
        <p>The next page is unwritten.</p>
        <a href={`mailto:${email}`}>{email} ↗</a>
        <nav aria-label="Social profiles">
          {socials.map((social) => <a href={social.href} target="_blank" rel="noopener noreferrer">{social.name}</a>)}
        </nav>
      </footer>
    </div>
  </main>
</div>

<style>
  .notes-world {
    --notes-paper: #f3efe4;
    --notes-ink: #292b2b;
    --notes-blue: #637f91;
    --notes-red: #b7483b;
    --notes-rule: rgba(41,43,43,.18);
    min-height: 100dvh;
    background: var(--notes-paper);
    color: var(--notes-ink);
    font-family: 'IBM Plex Mono', monospace;
  }
  .notes-world * { box-sizing: border-box; }
  .notes-world a { color: inherit; text-decoration: none; }
  .notes-world a:focus-visible { outline: 2px solid var(--notes-red); outline-offset: 5px; }
  .notes-top { min-height: 58px; padding: 0 clamp(18px, 3vw, 50px); display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 20px; border-bottom: 1px solid var(--notes-ink); font-size: 10px; text-transform: uppercase; letter-spacing: .07em; }
  .notes-top p { margin: 0; color: var(--notes-blue); }
  .notes-top > a:last-child { justify-self: end; min-height: 44px; display: inline-flex; align-items: center; border-bottom: 2px solid var(--notes-red); }
  .notes-wordmark { font-weight: 700; }
  .notes-book { width: min(1500px, 100%); margin: 0 auto; display: grid; grid-template-columns: clamp(132px, 15vw, 230px) 1fr; }
  .notes-margin { min-height: 100dvh; padding: 48px 28px; display: flex; flex-direction: column; gap: 34px; border-right: 1px solid var(--notes-ink); color: var(--notes-blue); font-size: 10px; line-height: 1.6; text-transform: uppercase; }
  .notes-margin p { margin: 0; }
  .notes-margin > span { margin-top: auto; color: var(--notes-red); font: 400 56px/1 'Fraunces', Georgia, serif; }
  .notes-pages { min-width: 0; }
  .notes-opening { min-height: 72dvh; padding: clamp(38px, 7vw, 110px) clamp(24px, 6vw, 100px) 50px; display: flex; flex-direction: column; justify-content: space-between; background-image: linear-gradient(var(--notes-rule) 1px, transparent 1px); background-size: 100% 32px; }
  .notes-date { width: fit-content; margin: 0; padding-right: 12px; background: var(--notes-paper); color: var(--notes-red); font-size: 10px; text-transform: uppercase; letter-spacing: .08em; }
  .notes-opening h1 { max-width: 1040px; margin: 54px 0; padding-right: 16px; background: var(--notes-paper); font: 400 clamp(3.2rem, 7.8vw, 8.2rem)/.92 'Fraunces', Georgia, serif; letter-spacing: -.055em; text-wrap: balance; }
  .notes-opening-grid { display: grid; grid-template-columns: minmax(240px, 560px) minmax(190px, 300px); justify-content: space-between; gap: 40px; }
  .notes-opening-grid p { margin: 0; padding: 10px 12px 10px 0; background: var(--notes-paper); font-size: clamp(12px, 1.1vw, 15px); line-height: 1.7; }
  .notes-pencil { color: var(--notes-blue); transform: rotate(-1deg); }
  .notes-index { border-top: 1px solid var(--notes-ink); }
  .notes-index > header { padding: 52px clamp(24px, 6vw, 100px); display: grid; grid-template-columns: 140px minmax(0, 720px); gap: 40px; }
  .notes-index header p { margin: 7px 0 0; color: var(--notes-red); font-size: 10px; text-transform: uppercase; }
  .notes-index h2 { margin: 0; font: 400 clamp(2.5rem, 5vw, 5.6rem)/.95 'Fraunces', Georgia, serif; letter-spacing: -.045em; }
  .notes-index ol { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--notes-rule); }
  .notes-index li { min-height: 270px; padding: 34px clamp(24px, 6vw, 100px); display: grid; grid-template-columns: 74px minmax(420px, 1fr) minmax(170px, 280px); gap: 32px; border-bottom: 1px solid var(--notes-rule); }
  .notes-entry-number { color: var(--notes-red); font-size: 14px; }
  .notes-entry-number span { display: block; margin-top: 8px; color: var(--notes-blue); font-size: 9px; }
  .notes-index li > a { min-width: 0; display: grid; grid-template-columns: minmax(220px, 1fr) minmax(180px, 320px); gap: 30px; align-items: center; }
  .notes-entry-copy { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; }
  .notes-entry-type { color: var(--notes-blue); font-size: 9px; text-transform: uppercase; letter-spacing: .07em; }
  .notes-entry-copy strong { font: 400 clamp(2.2rem, 4.2vw, 4.6rem)/.9 'Fraunces', Georgia, serif; letter-spacing: -.045em; }
  .notes-entry-copy > span:not(.notes-entry-type) { max-width: 520px; font-size: 12px; line-height: 1.65; }
  .notes-entry-copy em { min-height: 44px; display: inline-flex; align-items: center; color: var(--notes-red); font-size: 10px; font-style: normal; border-bottom: 1px solid currentColor; }
  .notes-entry-image { height: 180px; overflow: hidden; display: grid; place-items: center; border: 1px solid var(--notes-ink); background: #dcd7c9; }
  .notes-entry-image img { width: 100%; height: 100%; object-fit: cover; filter: saturate(.65); transition: filter 180ms ease-out, transform 180ms ease-out; }
  .notes-entry-image b { font: 400 50px/1 'Fraunces', Georgia, serif; }
  .notes-index aside { align-self: center; color: var(--notes-blue); font: 400 12px/1.6 'Fraunces', Georgia, serif; transform: rotate(-1.5deg); }
  .notes-index aside span { display: block; margin-bottom: 8px; color: var(--notes-red); font: 500 9px/1 'IBM Plex Mono', monospace; text-transform: uppercase; }
  .notes-footer { min-height: 380px; padding: 60px clamp(24px, 6vw, 100px) 110px; display: grid; grid-template-columns: 1fr auto; align-content: end; gap: 30px; }
  .notes-footer > p { grid-column: 1 / -1; margin: 0; font: 400 clamp(3rem, 7vw, 7rem)/.9 'Fraunces', Georgia, serif; letter-spacing: -.05em; }
  .notes-footer > a { width: fit-content; min-height: 44px; display: inline-flex; align-items: center; border-bottom: 2px solid var(--notes-red); }
  .notes-footer nav { display: flex; align-items: center; gap: 18px; font-size: 10px; }

  @media (hover: hover) and (pointer: fine) {
    .notes-index li > a:hover .notes-entry-image img { filter: saturate(1); transform: scale(1.025); }
    .notes-index li > a:hover .notes-entry-copy strong { color: var(--notes-red); }
  }
  @media (max-width: 860px) {
    .notes-book { grid-template-columns: 1fr; }
    .notes-margin { min-height: auto; padding: 16px 20px; flex-direction: row; align-items: center; justify-content: space-between; border-right: 0; border-bottom: 1px solid var(--notes-ink); }
    .notes-margin p:nth-child(3), .notes-margin > span { display: none; }
    .notes-opening { min-height: 78dvh; }
    .notes-index li { grid-template-columns: 52px minmax(0, 1fr); }
    .notes-index li > a { grid-template-columns: minmax(0, 1fr) 180px; }
    .notes-index aside { grid-column: 2; max-width: 520px; }
  }
  @media (max-width: 620px) {
    .notes-top { grid-template-columns: 1fr auto; }
    .notes-top p { display: none; }
    .notes-opening { padding: 34px 20px 40px; background-size: 100% 28px; }
    .notes-opening h1 { font-size: clamp(2.7rem, 13vw, 4.6rem); }
    .notes-opening-grid { grid-template-columns: 1fr; gap: 16px; }
    .notes-opening-grid .notes-pencil { max-width: 80%; margin-left: auto; }
    .notes-index > header { padding: 42px 20px; grid-template-columns: 1fr; gap: 12px; }
    .notes-index li { min-height: 0; padding: 28px 20px; grid-template-columns: 32px minmax(0,1fr); gap: 16px; }
    .notes-index li > a { grid-template-columns: minmax(0,1fr) 74px; gap: 14px; }
    .notes-entry-image { height: 96px; }
    .notes-entry-copy strong { font-size: clamp(1.9rem, 10vw, 3rem); }
    .notes-entry-copy > span:not(.notes-entry-type) { font-size: 11px; }
    .notes-index aside { grid-column: 2; font-size: 11px; }
    .notes-footer { padding: 52px 20px 100px; grid-template-columns: 1fr; }
    .notes-footer > p { grid-column: 1; }
    .notes-footer nav { flex-wrap: wrap; }
  }
  @media (prefers-reduced-motion: reduce) {
    .notes-world * { transition-duration: .01ms !important; }
  }
</style>
