---
import { email, projects, socials } from './data';
---

<div class="system-world">
  <header class="system-top">
    <a href="#system-top">tryraisins://home</a>
    <p><span aria-hidden="true"></span> operator available</p>
    <p>Lagos local / WAT</p>
    <a href={`mailto:${email}`}>new_message</a>
  </header>

  <main id="system-top" class="system-main">
    <section class="system-intro" aria-labelledby="system-title">
      <div class="system-label">OPERATOR PROFILE / 001</div>
      <h1 id="system-title">I build the interface,<br />the system beneath it,<br />and the path to production.</h1>
      <div class="system-summary">
        <p>TryRaisins is a software engineer working from Lagos on products that need to be clear, dependable, and real.</p>
        <dl>
          <div><dt>Focus</dt><dd>Full-stack products</dd></div>
          <div><dt>Mode</dt><dd>End to end</dd></div>
          <div><dt>Output</dt><dd>06 shipped systems</dd></div>
        </dl>
      </div>
    </section>

    <section class="system-grid" aria-labelledby="system-work-title">
      <header>
        <div>
          <span>SYSTEM INDEX</span>
          <h2 id="system-work-title">Recent deployments</h2>
        </div>
        <p>All statuses describe portfolio availability, not measured uptime.</p>
      </header>

      <ol>
        {projects.map((project) => (
          <li>
            <a href={project.href} target="_blank" rel="noopener noreferrer" aria-label={`Inspect ${project.name} in a new tab`}>
              <span class="system-card-top"><b>{project.number}</b><em>SHIPPED</em></span>
              <span class="system-thumb">
                {project.cover ? <img src={project.cover.src} alt={project.coverAlt} loading="lazy" /> : <strong aria-hidden="true">{project.monogram}</strong>}
              </span>
              <span class="system-card-copy">
                <strong>{project.name}</strong>
                <span>{project.description}</span>
              </span>
              <span class="system-card-bottom"><span>{project.type}</span><span>{project.year}</span><b>View project</b></span>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <section class="system-human" aria-labelledby="system-human-title">
      <div class="system-log" aria-hidden="true">
        <span>19:04:12</span><p>problem received</p>
        <span>19:04:19</span><p>assumptions questioned</p>
        <span>19:05:03</span><p>smallest useful system found</p>
        <span>later</span><p>shipped, checked, improved</p>
      </div>
      <div>
        <span>HUMAN NOTE</span>
        <h2 id="system-human-title">Reliable does not have to mean anonymous.</h2>
        <p>The details matter because somebody eventually has to use the thing. That is the part of software I like most.</p>
      </div>
    </section>

    <footer class="system-footer">
      <div><span>READY FOR INPUT</span><a href={`mailto:${email}`}>{email}</a></div>
      <nav aria-label="Social profiles">{socials.map((social) => <a href={social.href} target="_blank" rel="noopener noreferrer">[{social.name}]</a>)}</nav>
    </footer>
  </main>
</div>

<style>
  .system-world {
    --sys-bg: #101313;
    --sys-panel: #171b1b;
    --sys-ink: #e7e7dc;
    --sys-muted: #8f9a96;
    --sys-line: rgba(231,231,220,.17);
    --sys-cyan: #7bc7c5;
    --sys-lime: #d7ef78;
    min-height: 100dvh;
    background: var(--sys-bg);
    color: var(--sys-ink);
    font-family: 'Space Grotesk', sans-serif;
  }
  .system-world * { box-sizing: border-box; }
  .system-world a { color: inherit; text-decoration: none; }
  .system-world a:focus-visible { outline: 2px solid var(--sys-lime); outline-offset: 4px; }
  .system-top { min-height: 54px; padding: 0 clamp(16px, 2.5vw, 42px); display: grid; grid-template-columns: 1fr auto auto auto; align-items: center; gap: 30px; border-bottom: 1px solid var(--sys-line); font: 500 10px/1 'IBM Plex Mono', monospace; color: var(--sys-muted); }
  .system-top a:first-child { color: var(--sys-ink); }
  .system-top a:last-child { min-height: 44px; display: inline-flex; align-items: center; color: var(--sys-lime); }
  .system-top p { margin: 0; }
  .system-top p span { display: inline-block; width: 7px; height: 7px; margin-right: 7px; border-radius: 50%; background: var(--sys-lime); box-shadow: 0 0 9px rgba(215,239,120,.5); }
  .system-main { width: min(1680px, 100%); margin: 0 auto; border-inline: 1px solid var(--sys-line); }
  .system-intro { min-height: 78dvh; padding: clamp(30px, 4.5vw, 72px); display: grid; grid-template-rows: auto 1fr auto; background-image: linear-gradient(var(--sys-line) 1px, transparent 1px), linear-gradient(90deg,var(--sys-line) 1px,transparent 1px); background-size: 48px 48px; }
  .system-label, .system-grid header span, .system-human > div > span, .system-footer span { width: fit-content; padding: 7px 9px; background: var(--sys-ink); color: var(--sys-bg); font: 600 9px/1 'IBM Plex Mono', monospace; letter-spacing: .08em; }
  .system-intro h1 { max-width: 1380px; margin: auto 0; padding: 18px 0; font: 500 clamp(3.6rem, 8.9vw, 9.5rem)/.84 'Space Grotesk', sans-serif; letter-spacing: -.075em; text-wrap: balance; }
  .system-summary { display: grid; grid-template-columns: minmax(260px, 560px) 1fr; gap: 50px; align-items: end; }
  .system-summary > p { margin: 0; font-size: clamp(16px, 1.6vw, 23px); line-height: 1.4; color: var(--sys-muted); }
  .system-summary dl { margin: 0; display: grid; grid-template-columns: repeat(3,1fr); border: 1px solid var(--sys-line); background: var(--sys-bg); }
  .system-summary dl div { min-height: 76px; padding: 14px; border-right: 1px solid var(--sys-line); }
  .system-summary dl div:last-child { border-right: 0; }
  .system-summary dt { margin-bottom: 10px; color: var(--sys-muted); font: 500 9px/1 'IBM Plex Mono', monospace; text-transform: uppercase; }
  .system-summary dd { margin: 0; font-size: 13px; }
  .system-grid { padding: clamp(28px, 4.5vw, 72px); border-top: 1px solid var(--sys-line); }
  .system-grid > header { margin-bottom: 28px; display: flex; align-items: end; justify-content: space-between; gap: 30px; }
  .system-grid h2 { margin: 15px 0 0; font-size: clamp(2.5rem, 5vw, 5rem); line-height: .9; letter-spacing: -.055em; }
  .system-grid header p { max-width: 330px; margin: 0; color: var(--sys-muted); font: 400 10px/1.5 'IBM Plex Mono', monospace; text-align: right; }
  .system-grid ol { margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); list-style: none; border-top: 1px solid var(--sys-line); border-left: 1px solid var(--sys-line); }
  .system-grid li { min-width: 0; }
  .system-grid li > a { min-height: 450px; padding: 18px; display: grid; grid-template-rows: auto 1fr auto auto; gap: 18px; border-right: 1px solid var(--sys-line); border-bottom: 1px solid var(--sys-line); background: var(--sys-panel); transition: background-color 160ms ease-out; }
  .system-card-top, .system-card-bottom { display: flex; align-items: center; justify-content: space-between; gap: 12px; font: 500 9px/1 'IBM Plex Mono', monospace; }
  .system-card-top b { color: var(--sys-cyan); }
  .system-card-top em { padding: 4px 6px; border: 1px solid rgba(215,239,120,.38); color: var(--sys-lime); font-style: normal; }
  .system-thumb { min-height: 190px; overflow: hidden; display: grid; place-items: center; border: 1px solid var(--sys-line); background: var(--sys-bg); }
  .system-thumb img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(.6) brightness(.72); transition: filter 180ms ease-out, transform 180ms ease-out; }
  .system-thumb strong { color: var(--sys-lime); font: 500 54px/1 'Space Grotesk', sans-serif; }
  .system-card-copy { display: grid; gap: 10px; }
  .system-card-copy strong { font-size: clamp(1.7rem, 2.7vw, 3rem); line-height: .9; letter-spacing: -.045em; }
  .system-card-copy > span { max-width: 390px; color: var(--sys-muted); font-size: 12px; line-height: 1.5; }
  .system-card-bottom { padding-top: 16px; border-top: 1px solid var(--sys-line); color: var(--sys-muted); }
  .system-card-bottom b { color: var(--sys-lime); font-weight: 500; }
  .system-human { min-height: 78dvh; padding: clamp(36px, 6vw, 100px); display: grid; grid-template-columns: minmax(280px,.8fr) minmax(420px,1.2fr); gap: clamp(50px, 9vw, 150px); align-items: center; border-top: 1px solid var(--sys-line); }
  .system-log { padding: 24px; display: grid; grid-template-columns: 80px 1fr; border: 1px solid var(--sys-line); background: var(--sys-panel); font: 400 10px/1.4 'IBM Plex Mono', monospace; }
  .system-log span, .system-log p { margin: 0; padding: 14px 0; border-bottom: 1px solid var(--sys-line); }
  .system-log span { color: var(--sys-cyan); }
  .system-log p { color: var(--sys-muted); }
  .system-human h2 { max-width: 760px; margin: 22px 0; font-size: clamp(3rem, 6.5vw, 7rem); line-height: .87; letter-spacing: -.065em; }
  .system-human > div:last-child p { max-width: 600px; margin: 0; color: var(--sys-muted); font-size: 16px; line-height: 1.55; }
  .system-footer { min-height: 260px; padding: 48px clamp(20px, 4.5vw, 72px) 96px; display: flex; align-items: end; justify-content: space-between; gap: 34px; border-top: 1px solid var(--sys-line); }
  .system-footer > div { display: grid; gap: 18px; }
  .system-footer > div a { font-size: clamp(1.5rem, 3vw, 3.5rem); color: var(--sys-lime); }
  .system-footer nav { display: flex; gap: 15px; color: var(--sys-muted); font: 400 10px/1 'IBM Plex Mono', monospace; }
  @media (hover:hover) and (pointer:fine) {
    .system-grid li > a:hover { background: #1d2423; }
    .system-grid li > a:hover .system-thumb img { filter: grayscale(0) brightness(.9); transform: scale(1.025); }
  }
  @media (max-width: 900px) {
    .system-top { grid-template-columns: 1fr auto; }
    .system-top p { display: none; }
    .system-summary { grid-template-columns: 1fr; }
    .system-grid ol { grid-template-columns: repeat(2,minmax(0,1fr)); }
    .system-human { grid-template-columns: 1fr; }
  }
  @media (max-width: 580px) {
    .system-main { border-inline: 0; }
    .system-intro { min-height: calc(100dvh - 54px); padding: 28px 20px 42px; background-size: 32px 32px; }
    .system-intro h1 { font-size: clamp(3.1rem, 14.8vw, 5.3rem); }
    .system-summary dl { grid-template-columns: 1fr; }
    .system-summary dl div { min-height: 56px; border-right: 0; border-bottom: 1px solid var(--sys-line); }
    .system-grid { padding: 36px 20px 90px; }
    .system-grid > header { align-items: start; flex-direction: column; }
    .system-grid header p { text-align: left; }
    .system-grid ol { grid-template-columns: 1fr; }
    .system-grid li > a { min-height: 390px; }
    .system-human { padding: 58px 20px 100px; }
    .system-log { grid-template-columns: 68px 1fr; padding: 14px; }
    .system-footer { align-items: start; flex-direction: column; padding-inline: 20px; }
    .system-footer nav { flex-wrap: wrap; }
  }
  @media (prefers-reduced-motion: reduce) {
    .system-world * { transition-duration: .01ms !important; }
  }
</style>
