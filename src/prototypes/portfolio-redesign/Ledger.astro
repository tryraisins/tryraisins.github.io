---
import { email, projects, socials } from './data';
---

<div class="ledger-world">
  <header class="ledger-top">
    <a class="ledger-mark" href="#ledger-top" aria-label="TryRaisins home">TR<span>.</span></a>
    <p>Independent software engineer</p>
    <p class="ledger-place">Lagos, NG <span aria-hidden="true">/</span> 06°31′N</p>
    <a href={`mailto:${email}`}>Start a conversation</a>
  </header>

  <main id="ledger-top">
    <section class="ledger-hero" aria-labelledby="ledger-title">
      <div class="ledger-kicker">
        <span>Workshop ledger</span>
        <span>Issue 07 / 2026</span>
      </div>
      <h1 id="ledger-title">Useful software,<br />built all the way through.</h1>
      <div class="ledger-intro">
        <p>I’m TryRaisins. I turn complicated, real-world problems into products people can actually use.</p>
        <p class="ledger-stamp">Built here<br />sent everywhere</p>
      </div>
    </section>

    <section class="ledger-route" aria-labelledby="ledger-work-title">
      <header>
        <h2 id="ledger-work-title">Six stops. Six working systems.</h2>
        <p>Select a destination to leave the workshop.</p>
      </header>

      <ol>
        {projects.map((project) => (
          <li>
            <span class="ledger-node" aria-hidden="true"></span>
            <a href={project.href} target="_blank" rel="noopener noreferrer" aria-label={`Open ${project.name} in a new tab`}>
              <span class="ledger-number">{project.number}</span>
              <span class="ledger-project-copy">
                <strong>{project.name}</strong>
                <span>{project.description}</span>
              </span>
              <span class="ledger-project-meta">{project.type}<br />{project.year}</span>
              <span class="ledger-image">
                {project.cover ? <img src={project.cover.src} alt={project.coverAlt} loading="lazy" /> : <b aria-hidden="true">{project.monogram}</b>}
              </span>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <footer class="ledger-footer">
      <p>There is always another useful thing to make.</p>
      <nav aria-label="Social profiles">
        {socials.map((social) => <a href={social.href} target="_blank" rel="noopener noreferrer" aria-label={`${social.name}, opens in a new tab`}>{social.name}</a>)}
      </nav>
      <a class="ledger-email" href={`mailto:${email}`}>{email}</a>
    </footer>
  </main>
</div>

<style>
  .ledger-world {
    --ledger-paper: #f2f0e8;
    --ledger-ink: #171713;
    --ledger-yellow: #f4b900;
    --ledger-red: #d33b24;
    min-height: 100dvh;
    background: var(--ledger-paper);
    color: var(--ledger-ink);
    font-family: 'Space Grotesk', Arial, sans-serif;
  }

  .ledger-world * { box-sizing: border-box; }
  .ledger-world a { color: inherit; text-decoration: none; }
  .ledger-world a:focus-visible,
  .ledger-world button:focus-visible { outline: 3px solid var(--ledger-red); outline-offset: 4px; }

  .ledger-top {
    min-height: 64px;
    padding: 0 clamp(18px, 3vw, 48px);
    display: grid;
    grid-template-columns: 100px 1fr auto auto;
    align-items: center;
    gap: 28px;
    border-bottom: 2px solid var(--ledger-ink);
    font-size: 12px;
    font-weight: 650;
    letter-spacing: .01em;
  }

  .ledger-top p { margin: 0; }
  .ledger-top > a:last-child { min-height: 44px; display: inline-flex; align-items: center; border-bottom: 4px solid var(--ledger-yellow); }
  .ledger-mark { font-family: 'Archivo Black', Impact, sans-serif; font-size: 24px; letter-spacing: -.08em; }
  .ledger-mark span { color: var(--ledger-red); }
  .ledger-place { font-variant-numeric: tabular-nums; }

  .ledger-hero {
    min-height: min(72vh, 760px);
    padding: clamp(26px, 4vw, 64px) clamp(18px, 3vw, 48px) 34px;
    display: grid;
    grid-template-rows: auto 1fr auto;
    border-bottom: 2px solid var(--ledger-ink);
    background:
      linear-gradient(90deg, transparent 49.9%, rgba(23,23,19,.12) 50%, transparent 50.1%),
      var(--ledger-yellow);
  }

  .ledger-kicker,
  .ledger-intro { display: flex; justify-content: space-between; gap: 32px; }
  .ledger-kicker,
  .ledger-intro,
  .ledger-hero h1 { min-width: 0; }
  .ledger-kicker { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; }
  .ledger-hero h1 {
    max-width: 1320px;
    margin: auto 0;
    font-family: 'Archivo Black', Impact, sans-serif;
    font-size: clamp(4rem, 10.6vw, 10.5rem);
    line-height: .78;
    letter-spacing: -.085em;
    text-transform: uppercase;
  }

  .ledger-intro { align-items: end; }
  .ledger-intro > p:first-child { max-width: 560px; margin: 0; font-size: clamp(18px, 2vw, 28px); line-height: 1.15; font-weight: 560; }
  .ledger-stamp {
    margin: 0;
    padding: 12px 16px;
    border: 2px solid currentColor;
    color: var(--ledger-red);
    font: 700 11px/1.05 'Space Grotesk', sans-serif;
    text-align: center;
    text-transform: uppercase;
    transform: rotate(-3deg);
  }

  .ledger-route { padding: 0 clamp(18px, 3vw, 48px); }
  .ledger-route > header {
    min-height: 118px;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    padding: 28px 0 22px;
    border-bottom: 2px solid var(--ledger-ink);
  }
  .ledger-route h2 { max-width: 760px; margin: 0; font-family: 'Archivo Black', Impact, sans-serif; font-size: clamp(2.2rem, 5vw, 5rem); line-height: .9; letter-spacing: -.06em; }
  .ledger-route header p { max-width: 260px; margin: 0; font-size: 13px; text-align: right; }
  .ledger-route ol { margin: 0; padding: 0 0 0 32px; list-style: none; border-left: 4px solid var(--ledger-red); }
  .ledger-route li { position: relative; border-bottom: 1px solid rgba(23,23,19,.32); }
  .ledger-node { position: absolute; z-index: 2; top: 50%; left: -42px; width: 16px; height: 16px; border: 4px solid var(--ledger-red); background: var(--ledger-paper); transform: translateY(-50%); border-radius: 50%; }
  .ledger-route li a {
    min-height: 132px;
    display: grid;
    grid-template-columns: 54px minmax(220px, 1.1fr) minmax(160px, .7fr) 150px 24px;
    align-items: center;
    gap: clamp(12px, 2vw, 28px);
    transition: background-color 160ms ease-out, padding 160ms ease-out;
  }
  .ledger-number { color: var(--ledger-red); font-family: 'Archivo Black', Impact, sans-serif; font-size: 26px; }
  .ledger-project-copy { min-width: 0; display: grid; gap: 8px; }
  .ledger-project-copy strong { font-family: 'Archivo Black', Impact, sans-serif; font-size: clamp(1.8rem, 3.4vw, 3.6rem); line-height: .88; letter-spacing: -.055em; }
  .ledger-project-copy > span { max-width: 590px; font-size: 14px; color: rgba(23,23,19,.7); }
  .ledger-project-meta { font-size: 10px; line-height: 1.5; text-transform: uppercase; }
  .ledger-image { width: 150px; height: 86px; overflow: hidden; display: grid; place-items: center; border: 2px solid var(--ledger-ink); background: var(--ledger-ink); color: var(--ledger-yellow); }
  .ledger-image img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1); transition: filter 180ms ease-out, transform 180ms ease-out; }
  .ledger-image b { font-family: 'Archivo Black', Impact, sans-serif; font-size: 30px; }
  .ledger-footer { padding: 40px clamp(18px, 3vw, 48px) 100px; display: grid; grid-template-columns: 1fr auto; gap: 24px; background: var(--ledger-ink); color: var(--ledger-paper); }
  .ledger-footer p { max-width: 620px; margin: 0; font-family: 'Archivo Black', Impact, sans-serif; font-size: clamp(2.4rem, 6vw, 6rem); line-height: .9; letter-spacing: -.06em; }
  .ledger-footer nav { display: flex; flex-direction: column; align-items: flex-end; gap: 6px; font-size: 13px; }
  .ledger-email { grid-column: 1 / -1; width: fit-content; min-height: 44px; display: inline-flex; align-items: center; border-bottom: 4px solid var(--ledger-yellow); font-size: clamp(1.2rem, 3vw, 2.5rem); }

  @media (hover: hover) and (pointer: fine) {
    .ledger-route li a:hover { padding-inline: 14px; background: #fff; }
    .ledger-route li a:hover .ledger-image img { filter: grayscale(0); transform: scale(1.04); }
  }

  @media (max-width: 760px) {
    .ledger-top { grid-template-columns: 1fr auto; gap: 12px; }
    .ledger-top p { display: none; }
    .ledger-hero { min-height: 78dvh; background: var(--ledger-yellow); }
    .ledger-kicker,
    .ledger-intro { gap: 12px; }
    .ledger-kicker span:last-child { text-align: right; }
    .ledger-hero h1 { font-size: clamp(3rem, 15.5vw, 6.8rem); }
    .ledger-intro > p:first-child { max-width: 64%; font-size: 17px; }
    .ledger-route > header { align-items: start; flex-direction: column; }
    .ledger-route header p { text-align: left; }
    .ledger-route ol { padding-left: 24px; }
    .ledger-node { left: -32px; }
    .ledger-route li a { min-height: 150px; grid-template-columns: 34px minmax(0,1fr) 62px 18px; grid-template-rows: auto auto; gap: 8px 10px; }
    .ledger-number { grid-row: 1 / 3; align-self: start; padding-top: 4px; font-size: 18px; }
    .ledger-project-copy { grid-row: 1; }
    .ledger-project-copy strong { font-size: clamp(1.7rem, 8vw, 2.8rem); }
    .ledger-project-copy > span { font-size: 12px; }
    .ledger-project-meta { grid-column: 2; grid-row: 2; align-self: start; }
    .ledger-image { grid-column: 3; grid-row: 1 / 3; width: 62px; height: 72px; }
    .ledger-footer { grid-template-columns: 1fr; }
    .ledger-footer nav { align-items: flex-start; }
    .ledger-email { grid-column: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ledger-world * { transition-duration: .01ms !important; }
  }
</style>
