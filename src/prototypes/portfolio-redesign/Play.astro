---
import { Picture } from 'astro:assets';
import { email as defaultEmail, projects as defaultProjects, socials as defaultSocials } from './data';
const {
  email = defaultEmail,
  projects = defaultProjects,
  socials = defaultSocials,
} = Astro.props;
---

<div class="play-world" data-play-root>
  <a class="play-skip" href="#play-desk">Skip to work</a>
  <div class="play-battlefield" data-battlefield aria-hidden="true"></div>
  <main id="play-top">
    <section class="play-hero" aria-labelledby="play-title">
      <div class="play-doodle-layer play-doodle-layer-hero" aria-hidden="true">
        <figure class="play-drawing play-drawing-hero-a" data-doodle>
          <canvas class="play-drawing-canvas" data-doodle-canvas aria-hidden="true" width="240" height="175"></canvas>
        </figure>
        <figure class="play-drawing play-drawing-hero-b" data-doodle>
          <canvas class="play-drawing-canvas" data-doodle-canvas aria-hidden="true" width="240" height="175"></canvas>
        </figure>
      </div>
      <header class="play-hero-header">
        <p class="play-hero-index">Seun Sowemimo / Software engineer / Lagos</p>
        <a href="#play-contact">Get in touch <span aria-hidden="true">↗</span></a>
      </header>
      <h1 id="play-title">I build useful things for the web.</h1>
      <div class="play-intro">
        <p>I’m a software engineer who likes turning messy ideas into clear, dependable products. I work across the interface and the systems behind it, using React, TypeScript, Next.js, Node.js and Python.</p>
        <nav class="play-hero-actions" aria-label="Portfolio introduction">
          <a class="play-hero-primary" href="#play-desk">Explore my work <span aria-hidden="true">↓</span></a>
          <a class="play-hero-secondary" href="#play-contact">Get in touch</a>
        </nav>
      </div>
    </section>

    <section id="play-desk" class="play-desk" data-play-reveal aria-labelledby="play-work-title">
      <header>
        <p>Small ideas, shipped and in use</p>
        <h2 id="play-work-title">Things I’ve built</h2>
        <div class="play-desk-actions">
          <button type="button" data-shuffle aria-label="Shuffle the project desk">Shuffle desk</button>
        </div>
      </header>

      <ol data-play-grid>
        {projects.map((project, index) => (
          <li data-play-tile class={`play-tile play-tile-${index + 1}`} style={`--play-tile-index: ${index}`}>
            <a href={project.href} target="_blank" rel="noopener noreferrer" aria-label={`Open ${project.name} in a new tab`}>
              <span class="play-pin" aria-hidden="true"></span>
              <span class="play-photo">
                {project.cover ? (
                  <Picture
                    src={project.cover}
                    alt={project.coverAlt}
                    widths={[480, 720, 960]}
                    sizes="(max-width: 620px) calc(100vw - 94px), (max-width: 980px) 38vw, (max-width: 1455px) 26vw, 380px"
                    formats={['avif', 'webp']}
                    loading="lazy"
                  />
                ) : (
                  <span class="play-unexposed" role="img" aria-label={`An intentionally undeveloped camera still for ${project.name}`}>
                    <span class="play-unexposed-glow" aria-hidden="true"></span>
                    <small aria-hidden="true">UNEXPOSED / 35MM</small>
                  </span>
                )}
              </span>
              <span class="play-copy">
                <span>{project.number} / {project.type}</span>
                <strong>{project.name}</strong>
                <p>{project.description}</p>
                <span class="play-project-footer"><span>{project.year}</span><em>View project <span aria-hidden="true">↗</span></em></span>
              </span>
            </a>
          </li>
        ))}
      </ol>
      <div class="play-doodle-layer play-doodle-layer-desk" aria-hidden="true">
        <figure class="play-drawing play-drawing-desk" data-doodle>
          <canvas class="play-drawing-canvas" data-doodle-canvas aria-hidden="true" width="240" height="175"></canvas>
        </figure>
        <figure class="play-drawing play-drawing-desk-b" data-doodle>
          <canvas class="play-drawing-canvas" data-doodle-canvas aria-hidden="true" width="240" height="175"></canvas>
        </figure>
        <figure class="play-drawing play-drawing-desk-c" data-doodle>
          <canvas class="play-drawing-canvas" data-doodle-canvas aria-hidden="true" width="240" height="175"></canvas>
        </figure>
      </div>
    </section>

    <section id="play-contact" class="play-contact" data-play-reveal aria-labelledby="play-contact-title">
      <div class="play-doodle-layer play-doodle-layer-contact" aria-hidden="true">
        <figure class="play-drawing play-drawing-contact-a" data-doodle>
          <canvas class="play-drawing-canvas" data-doodle-canvas aria-hidden="true" width="240" height="175"></canvas>
        </figure>
        <figure class="play-drawing play-drawing-contact-b" data-doodle>
          <canvas class="play-drawing-canvas" data-doodle-canvas aria-hidden="true" width="240" height="175"></canvas>
        </figure>
      </div>
      <div class="play-contact-sheet">
        <span class="play-contact-tape" aria-hidden="true"></span>
        <header class="play-contact-meta">
          <p><span>07</span> Contact sheet</p>
          <p class="play-contact-availability"><span aria-hidden="true"></span> Open to thoughtful projects</p>
        </header>
        <div class="play-contact-heading">
          <p class="play-contact-label">Have something in mind?</p>
          <h2 id="play-contact-title">Let’s make it make sense.</h2>
          <p>Share what you’re building, what’s getting in the way, or where you need a second pair of eyes. I’m happy to start with the rough version.</p>
        </div>
        <div class="play-contact-body">
          <p class="play-contact-label">Write me an email</p>
          <a class="play-contact-email" href={`mailto:${email}?subject=Project%20enquiry`}>
            <span>{email}</span>
          </a>
          <p class="play-contact-location">Lagos, Nigeria · A real person will reply</p>
        </div>
        <aside class="play-contact-aside">
          <p class="play-contact-label">More of my work and notes</p>
          <nav aria-label="Social profiles">
            {socials.map((social, index) => (
              <a href={social.href} target="_blank" rel="noopener noreferrer" aria-label={`${social.name}, opens in a new tab`}>
                <span class="play-contact-social-number" aria-hidden="true">0{index + 1}</span>
                <span>{social.name}</span>
                <span class="play-contact-social-action" aria-hidden="true">Say hello</span>
              </a>
            ))}
          </nav>
        </aside>
      </div>
    </section>

  </main>
  <p class="play-sr-status" data-play-status aria-live="polite"></p>
</div>

<script>
  import { mountSpinningTops } from "./spinning-tops.js";
  import { mountDoodles } from "./doodle-notes.js";
  const root = document.querySelector('[data-play-root]');

  if (root instanceof HTMLElement) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const shuffle = root.querySelector('[data-shuffle]');
    const tiles = [...root.querySelectorAll('[data-play-tile]')];
    const status = root.querySelector('[data-play-status]');
    const revealTargets = [...root.querySelectorAll('[data-play-reveal]')];
    const battlefield = root.querySelector('[data-battlefield]');
    const hero = root.querySelector('.play-hero');
    const disposeDoodles = mountDoodles(root);
    document.addEventListener('astro:before-swap', disposeDoodles, { once: true });
    if (!reduceMotion.matches) {
      root.dataset.motion = 'ready';
      const reveal = (target) => target.setAttribute('data-visible', '');

      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            reveal(entry.target);
            observer.unobserve(entry.target);
          });
        }, { threshold: .12, rootMargin: '0px 0px -8% 0px' });
        revealTargets.forEach((target) => observer.observe(target));
      } else {
        revealTargets.forEach(reveal);
      }
    } else {
      revealTargets.forEach((target) => target.setAttribute('data-visible', ''));
    }

    shuffle?.addEventListener('click', () => {
      if (window.matchMedia('(max-width: 620px)').matches) return;
      const grid = root.querySelector('[data-play-grid]');
      if (!(grid instanceof HTMLElement)) return;
      const current = [...grid.querySelectorAll('[data-play-tile]')];
      tiles.forEach((tile) => tile.getAnimations().forEach((animation) => animation.cancel()));
      const shuffled = [...current];
      for (let index = shuffled.length - 1; index > 0; index--) {
        const other = Math.floor(Math.random() * (index + 1));
        [shuffled[index], shuffled[other]] = [shuffled[other], shuffled[index]];
      }
      // Every press produces a visible change, including a random identity permutation.
      if (shuffled.every((tile, index) => tile === current[index])) shuffled.push(shuffled.shift());
      const first = new Map(shuffled.map((tile) => [tile, tile.getBoundingClientRect()]));
      grid.append(...shuffled);
      if (!reduceMotion.matches) {
        shuffled.forEach((tile) => {
          const before = first.get(tile);
          const after = tile.getBoundingClientRect();
          if (!before) return;
          const rotation = getComputedStyle(tile).getPropertyValue('--play-desk-rotation');
          tile.animate([
            { transform: `translate(${before.left - after.left}px, ${before.top - after.top}px) rotate(${rotation})` },
            { transform: `translate(0, 0) rotate(${rotation})` },
          ], { duration: 360, easing: 'cubic-bezier(0.23, 1, 0.32, 1)' });
        });
      }
      shuffle.textContent = 'Shuffle again';
      if (status) status.textContent = 'The project desk has been rearranged into a new order.';
    });

    if (battlefield instanceof HTMLElement && hero instanceof HTMLElement) {
      const dispose = mountSpinningTops(battlefield, hero);
      document.addEventListener("astro:before-swap", dispose, { once: true });
    }
  }
</script>

<style>
  .play-world {
    --play-paper: #fbfaf5;
    --play-ink: #171719;
    --play-red: #f05c45;
    --play-blue: #315fe9;
    --play-yellow: #f0ce4e;
    --play-page-margin: max(clamp(32px, 6vw, 96px), calc((100% - 1280px) / 2));
    --play-ease-out: cubic-bezier(0.23, 1, 0.32, 1);
    min-height: 100dvh;
    background-color: #e7ddc9;
    background-image:
      repeating-linear-gradient(to bottom, transparent 0, transparent 35px, rgba(85,126,166,.12) 35px, rgba(85,126,166,.12) 36px),
      linear-gradient(90deg, transparent 0 calc(var(--play-page-margin) - 2px), rgba(210,84,72,.22) calc(var(--play-page-margin) - 2px), rgba(210,84,72,.22) var(--play-page-margin), transparent var(--play-page-margin));
    background-size: 100% 36px, 100% 100%;
    color: var(--play-ink);
    font-family: 'DM Sans', sans-serif;
  }
  .play-world * { box-sizing: border-box; }
  .play-world a { color: inherit; text-decoration: none; }
  .play-world a:focus-visible,
  .play-world button:focus-visible { outline: 3px solid var(--play-blue); outline-offset: 4px; }
  .play-skip { position: fixed; z-index: 20; top: 8px; left: 8px; min-height: 44px; padding: 0 14px; display: inline-flex; align-items: center; background: var(--play-ink); color: var(--play-paper) !important; font-size: 14px; transform: translateY(-150%); transition: transform 160ms var(--play-ease-out); }
  .play-skip:focus { transform: translateY(0); }
  .play-hero { min-height: 100dvh; padding: 40px var(--play-page-margin) 64px; position: relative; overflow: hidden; display: flex; flex-direction: column; gap: 64px; background: transparent; }
  .play-hero-header { position: relative; z-index: 1; display: flex; justify-content: space-between; align-items: center; gap: 24px; }
  .play-hero-header > a { min-height: 48px; display: inline-flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 500; white-space: nowrap; }
  .play-hero-index { width: fit-content; position: relative; margin: 0; padding: 8px 0; color: rgba(23,23,25,.76); font-size: 12px; line-height: 1.5; letter-spacing: .04em; text-transform: uppercase; }
  .play-hero-index::after { content: ''; position: absolute; right: 0; bottom: 3px; left: 0; border-bottom: 2px solid var(--play-red); transform: rotate(.8deg); }
  .play-hero h1 { max-width: 1080px; position: relative; z-index: 1; margin: auto 0 0; font: 600 clamp(4.5rem, 7.8vw, 7rem)/1.02 'Bricolage Grotesque', sans-serif; letter-spacing: -.03em; text-wrap: balance; }
  .play-intro { position: relative; z-index: 1; display: grid; justify-items: start; gap: 28px; }
  .play-intro p { max-width: 640px; margin: 0; color: rgba(23,23,25,.8); font-size: 21px; line-height: 1.5; }
  .play-hero-actions { display: flex; align-items: flex-start; flex-wrap: wrap; gap: 16px; }
  .play-hero-actions a { min-height: 48px; display: inline-flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 600; }
  .play-hero-primary { padding: 0 18px; border: 1px solid var(--play-ink); background: var(--play-yellow); box-shadow: 3px 3px 0 var(--play-ink); transition: transform 130ms var(--play-ease-out), box-shadow 130ms var(--play-ease-out); }
  .play-hero-primary:active { transform: translate(2px,2px); box-shadow: 1px 1px 0 var(--play-ink); }
  .play-hero-secondary { padding: 0 8px; border-bottom: 2px solid var(--play-red); }
  .play-battlefield { position: fixed; z-index: 0; inset: 0; overflow: hidden; pointer-events: none; }
  .play-desk { padding: 80px var(--play-page-margin) 100px; position: relative; background: transparent; }
  .play-desk > header { position: relative; z-index: 1; margin-bottom: 48px; display: grid; grid-template-columns: 1fr auto; align-items: end; gap: 16px 30px; }
  .play-desk > header > p { grid-column: 1 / -1; width: fit-content; position: relative; margin: 0; padding: 4px 0; color: rgba(23,23,25,.76); font-size: 13px; line-height: 1.5; }
  .play-desk > header > p::after { content: ''; position: absolute; right: 0; bottom: -1px; width: 72%; border-bottom: 2px solid var(--play-red); transform: rotate(-2deg); pointer-events: none; }
  .play-desk-actions { display: grid; justify-items: end; }
  .play-desk-actions button { min-width: 132px; min-height: 48px; padding: 0 18px; border: 1px solid var(--play-ink); border-radius: 0; background: var(--play-yellow); color: var(--play-ink); font: 600 14px/1 'DM Sans', sans-serif; cursor: pointer; box-shadow: 3px 3px 0 var(--play-ink); transition: transform 130ms var(--play-ease-out), box-shadow 130ms var(--play-ease-out); }
  .play-desk-actions button:active { transform: translate(2px, 2px); box-shadow: 1px 1px 0 var(--play-ink); }
  .play-desk h2 { margin: 0; font: 600 clamp(2.75rem, 5vw, 4.5rem)/1.05 'Bricolage Grotesque', sans-serif; letter-spacing: -.03em; }
  .play-desk ol { margin: 0; padding: 12px 0 0; position: relative; z-index: 1; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px 28px; list-style: none; }
  .play-tile { min-width: 0; position: relative; transform: rotate(var(--play-desk-rotation)); }
  .play-tile a { height: 100%; padding: 18px; display: grid; grid-template-rows: 225px 1fr; gap: 20px; position: relative; border: 1px solid var(--play-ink); background: var(--play-paper); box-shadow: 4px 5px 0 rgba(23,23,25,.16); transition: translate 180ms var(--play-ease-out); }
  .play-tile-1 { --play-desk-rotation: -1deg; }
  .play-tile-2 { --play-desk-rotation: .8deg; }
  .play-tile-3 { --play-desk-rotation: -.6deg; }
  .play-tile-4 { --play-desk-rotation: .7deg; }
  .play-tile-5 { --play-desk-rotation: -.8deg; }
  .play-tile-6 { --play-desk-rotation: 1deg; }
  .play-pin { position: absolute; z-index: 2; top: -8px; left: 50%; width: 36px; height: 16px; background: rgba(240,206,78,.8); border: 1px solid rgba(23,23,25,.35); transform: translateX(-50%) rotate(-2deg); }
  .play-photo { min-width: 0; overflow: hidden; display: grid; place-items: center; border: 1px solid rgba(23,23,25,.22); background: #ece8dc; }
  .play-photo picture, .play-photo img { width: 100%; height: 100%; display: block; }
  .play-photo img { object-fit: cover; filter: saturate(.78); transition: filter 180ms ease, transform 180ms var(--play-ease-out); }
  .play-unexposed { width: 100%; height: 100%; position: relative; isolation: isolate; display: grid; place-items: center; overflow: hidden; color: rgba(251,250,245,.88); background: linear-gradient(142deg, #111 0 23%, #343331 45%, #171719 72%); }
  .play-unexposed::before, .play-unexposed::after { content: ''; position: absolute; inset: 0; pointer-events: none; }
  .play-unexposed::before { z-index: -1; opacity: .74; background: radial-gradient(circle at 70% 18%, rgba(240,206,78,.3), transparent 20%), radial-gradient(circle at 34% 72%, rgba(240,92,69,.38), transparent 28%), repeating-linear-gradient(0deg, rgba(255,255,255,.055) 0 1px, transparent 1px 4px); }
  .play-unexposed::after { border: 12px solid rgba(23,23,25,.64); box-shadow: inset 0 0 42px rgba(0,0,0,.9); }
  .play-unexposed-glow { width: 36%; aspect-ratio: 1; border: 1px solid rgba(251,250,245,.7); border-radius: 50%; background: rgba(240,206,78,.16); filter: blur(10px); }
  .play-unexposed small { position: absolute; z-index: 1; bottom: 12px; left: 12px; font-size: 11px; line-height: 1; letter-spacing: .08em; }
  .play-copy { min-width: 0; display: flex; flex-direction: column; gap: 12px; }
  .play-copy > span:not(.play-project-footer) { color: rgba(23,23,25,.65); font-size: 11px; line-height: 1.4; text-transform: uppercase; letter-spacing: .06em; }
  .play-copy strong { font: 600 clamp(1.75rem, 2.4vw, 2.125rem)/1.1 'Bricolage Grotesque', sans-serif; letter-spacing: -.025em; }
  .play-copy p { margin: 0 0 8px; font-size: 15px; line-height: 1.5; }
  .play-project-footer { margin-top: auto; display: flex; justify-content: space-between; align-items: center; gap: 12px; font-size: 12px; line-height: 1.5; }
  .play-project-footer em { color: var(--play-blue); font-size: 14px; font-weight: 500; font-style: normal; white-space: nowrap; }
  .play-contact { padding: 140px var(--play-page-margin) 160px; position: relative; background: transparent; }
  .play-contact-sheet { width: min(1120px, 100%); margin: 0 auto; padding: clamp(32px, 4.2vw, 60px); position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); gap: 0 40px; background: #f3d665; box-shadow: 8px 10px 0 var(--play-red), 12px 15px 0 rgba(23,23,25,.14); transform: rotate(-.35deg); }
  .play-contact-sheet::before { content: ''; position: absolute; inset: -4px 7px 5px -5px; border: 3px solid var(--play-ink); border-radius: 2% 4% 3% 2%; transform: rotate(.55deg); pointer-events: none; }
  .play-contact-sheet::after { content: ''; position: absolute; inset: 5px -4px -3px 5px; border: 1px solid rgba(23,23,25,.78); border-radius: 4% 2% 2% 3%; transform: rotate(-.3deg); pointer-events: none; }
  .play-contact-sheet > * { position: relative; z-index: 1; }
  .play-contact-sheet > .play-contact-tape { width: 118px; height: 13px; position: absolute; top: -8px; left: 50%; border: 2px solid var(--play-ink); background: var(--play-red); transform: translateX(-50%) rotate(-3deg); box-shadow: 3px 3px 0 var(--play-ink); }
  .play-contact-meta { grid-column: 1 / -1; margin-bottom: 48px; padding-bottom: 16px; display: flex; align-items: center; justify-content: space-between; gap: 20px; border-bottom: 2px solid var(--play-ink); font-size: 12px; line-height: 1.5; text-transform: uppercase; letter-spacing: .04em; }
  .play-contact-meta p { margin: 0; }
  .play-contact-meta > p:first-child span { margin-right: 9px; color: var(--play-blue); font-weight: 600; }
  .play-contact-availability { display: inline-flex; align-items: center; gap: 8px; }
  .play-contact-availability > span { width: 9px; height: 9px; flex-shrink: 0; border: 1px solid var(--play-ink); border-radius: 50%; background: var(--play-yellow); box-shadow: 1px 1px 0 var(--play-ink); }
  .play-contact-heading { min-width: 0; }
  .play-contact-label { margin: 0; color: rgba(23,23,25,.7); font-size: 12px; line-height: 1.5; text-transform: uppercase; letter-spacing: .04em; }
  .play-contact-heading h2 { margin: 16px 0 24px; font: 600 clamp(2.75rem, 5vw, 4.5rem)/1.05 'Bricolage Grotesque', sans-serif; letter-spacing: -.03em; text-wrap: balance; }
  .play-contact-heading > p:last-child { max-width: 500px; margin: 0; color: rgba(23,23,25,.8); font-size: 18px; line-height: 1.5; }
  .play-contact-body { min-width: 0; padding: 4px 0 0 32px; border-left: 2px solid var(--play-ink); }
  .play-contact-email { width: 100%; min-height: 64px; margin-top: 16px; padding: 0 0 12px; display: flex; align-items: center; border-bottom: 3px solid var(--play-red); font-size: clamp(1.375rem, 2.2vw, 2rem); font-weight: 500; line-height: 1.3; letter-spacing: -.025em; }
  .play-contact-email > span { min-width: 0; overflow-wrap: anywhere; }
  .play-contact-location { margin: 24px 0 0; color: rgba(23,23,25,.7); font-size: 13px; line-height: 1.5; }
  .play-contact-aside { grid-column: 1 / -1; margin-top: 48px; padding-top: 20px; border-top: 2px solid var(--play-ink); }
  .play-contact-aside nav { margin-top: 12px; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px; }
  .play-contact-aside a { min-width: 0; min-height: 48px; padding: 4px 0; display: inline-flex; align-items: center; gap: 12px; border-bottom: 2px solid var(--play-ink); font-size: 14px; font-weight: 600; transition: background-color 140ms ease, transform 140ms var(--play-ease-out), border-color 140ms ease; }
  .play-contact-social-number { color: var(--play-blue); font-size: 11px; }
  .play-contact-social-action { margin-left: auto; color: rgba(23,23,25,.7); font-size: 11px; font-weight: 500; white-space: nowrap; }
  .play-sr-status { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .play-doodle-layer { position: absolute; inset: 0; z-index: 0; overflow: hidden; pointer-events: none; }
  .play-doodle-layer-desk { overflow: hidden; }
  .play-drawing { --drawing-rotation: 0deg; position: absolute; width: min(250px, 24vw); aspect-ratio: 1.37; margin: 0; transform: rotate(var(--drawing-rotation)); pointer-events: none; opacity: .86; mix-blend-mode: multiply; }
  .play-drawing-canvas { width: 100%; height: 100%; display: block; pointer-events: none; }
  .play-drawing-hero-a { top: 12%; left: -38px; --drawing-rotation: -5deg; }
  .play-drawing-hero-b { top: 52%; right: 5%; --drawing-rotation: 2.5deg; }
  .play-drawing-desk { top: 72%; left: -42px; --drawing-rotation: -3deg; }
  .play-drawing-desk-b { top: 29%; left: 43%; --drawing-rotation: 1.2deg; }
  .play-drawing-desk-c { top: 79%; right: 5%; --drawing-rotation: -2.4deg; }
  .play-drawing-contact-a { top: 20px; left: -35px; --drawing-rotation: -4deg; }
  .play-drawing-contact-b { right: 9%; bottom: 20px; --drawing-rotation: 2.2deg; }

  @media (prefers-reduced-motion: no-preference) {
