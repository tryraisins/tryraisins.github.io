---
import '../styles/global.css';

const projects = [
  { number: '01', name: 'QuickBillz', type: 'Product / Invoicing', year: '2026', href: 'https://quickbillz.tryraisins.dev/' },
  { number: '02', name: 'Terror Tracker', type: 'Live intelligence map', year: '2026', href: 'https://terrortracker.tryraisins.dev/' },
  { number: '03', name: 'Talent Hunter', type: 'Applied NLP', year: '2026', href: 'https://talenthunter.tryraisins.dev/' },
  { number: '04', name: 'yeknal', type: 'NPM CLI / Agent skills', year: '2026', href: 'https://www.npmjs.com/package/yeknal' },
  { number: '05', name: 'StreamSlip', type: 'Music recap utility', year: '2025', href: 'https://streamslip.vercel.app/' },
  { number: '06', name: 'BetPicks', type: 'Sports picks product', year: '2026', href: 'https://betpicks.tryraisins.dev/' },
];

const socials = [
  { name: 'GitHub', href: 'https://github.com/tryraisins', icon: 'github' },
  { name: 'LinkedIn', href: 'https://www.linkedin.com/in/seun-sowemimo-8518b7249/', icon: 'linkedin' },
  { name: 'Medium', href: 'https://medium.com/@TryRaisins', icon: 'medium' },
];

const siteUrl = 'https://tryraisins.dev/';
const pageTitle = 'Seun Sowemimo (TryRaisins) | Software Engineer, Lagos';
const pageDescription = 'Seun Sowemimo, known as TryRaisins, is a Lagos-based fullstack developer building reliable web products with React, TypeScript, Node.js, and Python.';
const socialImage = `${siteUrl}og-image.png?v=2`;
const seoSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${siteUrl}#person`,
      name: 'Seun Sowemimo',
      alternateName: 'TryRaisins',
      url: siteUrl,
      image: socialImage,
      jobTitle: 'Fullstack Developer',
      description: pageDescription,
      email: 'mailto:tryraisins@gmail.com',
      homeLocation: { '@type': 'Place', name: 'Lagos, Nigeria' },
      sameAs: socials.map((social) => social.href),
      knowsAbout: ['React', 'TypeScript', 'JavaScript', 'Node.js', 'Python', 'Web development', 'Frontend development', 'Backend development'],
    },
    {
      '@type': 'Organization',
      '@id': `${siteUrl}#brand`,
      name: 'TryRaisins',
      url: siteUrl,
      founder: { '@id': `${siteUrl}#person` },
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      url: siteUrl,
      name: 'TryRaisins',
      description: pageDescription,
      publisher: { '@id': `${siteUrl}#brand` },
    },
    {
      '@type': 'ProfilePage',
      '@id': `${siteUrl}#profile`,
      url: siteUrl,
      name: pageTitle,
      description: pageDescription,
      isPartOf: { '@id': `${siteUrl}#website` },
      mainEntity: { '@id': `${siteUrl}#person` },
    },
    {
      '@type': 'ItemList',
      '@id': `${siteUrl}#projects`,
      name: 'TryRaisins projects',
      itemListElement: projects.map((project, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        item: {
          '@type': 'CreativeWork',
          name: project.name,
          description: `${project.type} project by TryRaisins`,
          url: project.href,
        },
      })),
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="theme-color" content="#111418" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content="TryRaisins" />
    <meta name="keywords" content="TryRaisins, fullstack developer, React developer, TypeScript developer, Node.js developer, Python developer, web developer portfolio" />
    <link rel="canonical" href={siteUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:site_name" content="TryRaisins" />
    <meta property="og:locale" content="en_NG" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="TryRaisins software engineer portfolio" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="TryRaisins software engineer portfolio" />
    <meta name="twitter:creator" content="@tryraisins" />
    <script id="structured-data" type="application/ld+json" set:html={JSON.stringify(seoSchema)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500&family=IBM+Plex+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip-link" href="#work">Skip to work</a>
    <div class="paper-grain" aria-hidden="true"></div>

    <div class="site-shell">
      <header class="topbar">
        <a class="brand" href="#top" aria-label="TryRaisins home">TryRaisins</a>
        <p class="location">Software engineer <span aria-hidden="true">·</span> Lagos, Nigeria</p>
        <a class="hello" href="mailto:tryraisins@gmail.com">Say hello <span aria-hidden="true">↗</span></a>
      </header>

      <main id="top" class="portfolio">
        <section class="identity" aria-labelledby="hero-title">
          <div class="identity-copy">
            <h1 id="hero-title">I’m TryRaisins. I design and build reliable products, interfaces, and systems for real use.</h1>
          </div>

          <div class="identity-footer">
            <nav class="social-links" aria-label="Social profiles">
              {socials.map((social) => (
                <a href={social.href} target="_blank" rel="noopener noreferrer" aria-label={`Visit TryRaisins on ${social.name}`}>
                  {social.icon === 'github' && (
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .7A11.3 11.3 0 0 0 8.4 22.72c.57.1.77-.24.77-.54v-2.1c-3.15.68-3.81-1.34-3.81-1.34-.52-1.31-1.26-1.66-1.26-1.66-1.03-.7.08-.69.08-.69 1.14.08 1.74 1.17 1.74 1.17 1.01 1.73 2.65 1.23 3.3.94.1-.73.4-1.23.72-1.51-2.51-.29-5.15-1.26-5.15-5.59 0-1.24.44-2.25 1.17-3.04-.12-.29-.51-1.44.11-3 0 0 .95-.31 3.11 1.16a10.8 10.8 0 0 1 5.66 0c2.16-1.47 3.11-1.16 3.11-1.16.62 1.56.23 2.71.11 3 .73.79 1.17 1.8 1.17 3.04 0 4.34-2.65 5.3-5.17 5.58.41.35.77 1.04.77 2.1v3.12c0 .3.2.65.78.54A11.3 11.3 0 0 0 12 .7Z" /></svg>
                  )}
                  {social.icon === 'linkedin' && (
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5.34 3.5A2.34 2.34 0 1 1 .66 3.5a2.34 2.34 0 0 1 4.68 0ZM.94 7.1h4.8V22H.94V7.1Zm7.6 0h4.6v2.04h.06c.64-1.21 2.2-2.49 4.53-2.49 4.85 0 5.75 3.2 5.75 7.35v8h-4.79v-7.09c0-1.69-.03-3.87-2.36-3.87-2.36 0-2.72 1.84-2.72 3.75V22H8.54V7.1Z" /></svg>
                  )}
                  {social.icon === 'medium' && (
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.37 7.01a.8.8 0 0 0-.26-.68L2.18 4.01v-.35h6l4.64 10.17L16.9 3.66h5.72v.35l-1.65 1.58a.48.48 0 0 0-.18.46v11.62a.48.48 0 0 0 .18.46l1.61 1.58v.35h-8.1v-.35l1.67-1.62c.16-.16.16-.21.16-.46V8.24l-4.65 11.78h-.64L5.6 8.24v7.9a1.08 1.08 0 0 0 .3.9l2.17 2.63v.35H1.9v-.35l2.17-2.63a1.04 1.04 0 0 0 .28-.9V7.01Z" /></svg>
                  )}
                  <span>{social.name}</span>
                </a>
              ))}
            </nav>
          </div>
        </section>

        <section id="work" class="work-board" aria-labelledby="work-title">
          <header class="work-header">
            <h2 id="work-title">Work</h2>
            <span class="work-count" aria-label="Six projects">01 / 06</span>
          </header>

          <ol class="project-list">
            {projects.map((project) => (
              <li>
                <a class="project" href={project.href} target="_blank" rel="noopener noreferrer" aria-label={`Open ${project.name}`}>
                  <span class="project-number">{project.number}</span>
                  <span class="project-name">{project.name}</span>
                  <span class="project-type">{project.type}</span>
                  <span class="project-year">{project.year}</span>
                  <span class="project-arrow" aria-hidden="true">↗</span>
                </a>
              </li>
            ))}
          </ol>

          <footer class="work-footer">
            <p>Six shipped systems. More are taking shape.</p>
            <a href="mailto:tryraisins@gmail.com">tryraisins@gmail.com <span aria-hidden="true">↗</span></a>
          </footer>
        </section>
      </main>
    </div>
  </body>
</html>

<style is:global>
  :root {
    --paper: #111418;
    --paper-raised: #1a1f25;
    --ink: #edf0f2;
    --muted: #a0a7ae;
    --faint: #707981;
    --line: rgba(237, 240, 242, .14);
    --line-strong: rgba(237, 240, 242, .34);
    --accent: #91afc8;
    --accent-soft: #1c2b37;
    --gutter: clamp(20px, 3.6vw, 58px);
  }

  * { box-sizing: border-box; }

  html {
    min-width: 320px;
    background: var(--paper);
    scroll-behavior: smooth;
  }

  body {
    min-width: 320px;
    min-height: 100dvh;
    margin: 0;
    overflow-x: hidden;
    background:
      linear-gradient(rgba(237, 240, 242, .025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(237, 240, 242, .025) 1px, transparent 1px),
      var(--paper);
    background-size: 28px 28px;
    color: var(--ink);
    font-family: 'Space Grotesk', sans-serif;
  }

  a { color: inherit; text-decoration: none; }
  ::selection { background: var(--accent-soft); color: var(--ink); }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }

  .skip-link {
    position: fixed;
    z-index: 20;
    top: 8px;
    left: 8px;
    min-height: 44px;
    padding: 0 14px;
    display: inline-flex;
    align-items: center;
    background: var(--ink);
    color: var(--paper);
    font: 500 11px/1 'IBM Plex Mono', monospace;
    transform: translateY(-140%);
    transition: transform 160ms ease-out;
  }

  .skip-link:focus { transform: translateY(0); }

  .paper-grain {
    position: fixed;
    z-index: 10;
    inset: 0;
    pointer-events: none;
    opacity: .22;
    mix-blend-mode: screen;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 160 160' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.82' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.08'/%3E%3C/svg%3E");
  }

  .site-shell {
    position: relative;
    z-index: 1;
    width: min(1600px, 100%);
    min-height: 100dvh;
    margin: 0 auto;
    border-inline: 1px solid var(--line);
    background: rgba(17, 20, 24, .94);
    animation: pageIn 520ms cubic-bezier(.22, 1, .36, 1) both;
  }

  .topbar {
    height: 58px;
    padding: 0 var(--gutter);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
    border-bottom: 1px solid var(--line-strong);
    font: 500 10px/1 'IBM Plex Mono', monospace;
    letter-spacing: .09em;
    text-transform: uppercase;
  }

  .brand,
  .hello {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .brand { justify-self: start; }
  .location { margin: 0; color: var(--muted); }
  .hello { justify-self: end; gap: 8px; color: var(--accent); }

  .brand,
  .hello,
  .social-links a,
  .project,
  .work-footer a { transition: color 160ms ease-out, background-color 160ms ease-out, transform 160ms ease-out; }

  .portfolio {
    min-height: calc(100dvh - 58px);
    display: grid;
    grid-template-columns: minmax(340px, .82fr) minmax(600px, 1.18fr);
  }

  .identity {
    min-width: 0;
    padding: clamp(32px, 4.6vh, 58px) var(--gutter) clamp(24px, 3.5vh, 42px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border-right: 1px solid var(--line-strong);
  }

  .identity h1 {
    max-width: 760px;
    margin: 0;
    font: 400 clamp(3.4rem, 5.2vw, 6rem)/.92 'Fraunces', Georgia, serif;
    letter-spacing: -.05em;
    text-wrap: balance;
  }

  .identity-footer { margin-top: 38px; }

  .social-links {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-block: 1px solid var(--line);
  }

  .social-links a {
    min-width: 0;
    min-height: 50px;
    padding: 0 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    border-right: 1px solid var(--line);
    color: var(--muted);
    font: 500 10px/1 'IBM Plex Mono', monospace;
    letter-spacing: .04em;
  }

  .social-links a:last-child { border-right: 0; }
  .social-links svg { width: 17px; height: 17px; flex: 0 0 auto; fill: currentColor; }

  .work-board {
    min-width: 0;
    padding: clamp(28px, 4vh, 46px) var(--gutter) clamp(22px, 3vh, 34px);
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    animation: boardIn 600ms cubic-bezier(.22, 1, .36, 1) both 80ms;
  }

  .work-header {
    padding-bottom: clamp(18px, 2.8vh, 30px);
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
  }

  .work-header h2 {
    margin: 0;
    font: 400 clamp(2.3rem, 3.6vw, 4rem)/.9 'Fraunces', Georgia, serif;
    letter-spacing: -.045em;
  }

  .work-count {
    color: var(--accent);
    font: 500 11px/1 'IBM Plex Mono', monospace;
    letter-spacing: .08em;
  }

  .project-list {
    min-height: 0;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-rows: repeat(6, minmax(58px, 1fr));
    list-style: none;
    border-top: 1px solid var(--line-strong);
  }

  .project-list li { min-width: 0; border-bottom: 1px solid var(--line); }

  .project {
    width: 100%;
    height: 100%;
    min-height: 58px;
    display: grid;
    grid-template-columns: 32px minmax(160px, 1.1fr) minmax(150px, .9fr) 46px 28px;
    align-items: center;
    gap: clamp(10px, 1.5vw, 24px);
  }

  .project-number,
  .project-type,
  .project-year,
  .project-arrow { font-family: 'IBM Plex Mono', monospace; }

  .project-number { color: var(--accent); font-size: 10px; }
  .project-name { min-width: 0; font: 400 clamp(1.4rem, 2vw, 2.2rem)/1 'Fraunces', Georgia, serif; letter-spacing: -.035em; }
  .project-type { min-width: 0; color: var(--muted); font-size: 9px; line-height: 1.35; letter-spacing: .04em; text-transform: uppercase; }
  .project-year { color: var(--faint); font-size: 9px; }
  .project-arrow { color: var(--accent); font-size: 14px; text-align: right; }

  .work-footer {
    min-height: 54px;
    padding-top: clamp(14px, 2vh, 22px);
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    color: var(--muted);
    font: 400 10px/1.4 'IBM Plex Mono', monospace;
  }

  .work-footer p { margin: 0; }
  .work-footer a { color: var(--accent); }

  @media (hover: hover) and (pointer: fine) {
    .brand:hover,
    .hello:hover,
    .work-footer a:hover { color: var(--ink); }
    .social-links a:hover { color: var(--paper-raised); background: var(--accent); }
    .project:hover { padding-inline: 12px 8px; background: var(--accent-soft); }
    .project:hover .project-name { color: var(--accent); }
  }

  @media (max-width: 980px) {
    .site-shell { border-inline: 0; }
    .portfolio { min-height: auto; grid-template-columns: 1fr; }
    .identity { min-height: 46dvh; border-right: 0; border-bottom: 1px solid var(--line-strong); }
    .identity h1 { font-size: clamp(3.6rem, 8.5vw, 6.3rem); }
    .identity-footer { margin-top: 42px; }
    .work-board { min-height: 54dvh; }
  }

  @media (max-width: 680px) {
    :root { --gutter: 18px; }
    .topbar { height: 52px; grid-template-columns: 1fr 1fr; }
    .location { display: none; }
    .portfolio { min-height: calc(100dvh - 52px); }
    .identity { min-height: 0; padding-block: 22px 18px; }
    .identity h1 { font-size: clamp(2.6rem, 11.8vw, 3.3rem); line-height: .96; }
    .identity-footer { margin-top: 20px; }
    .social-links a { min-height: 44px; padding-inline: 6px; gap: 7px; font-size: 9px; }
    .social-links svg { width: 15px; height: 15px; }
    .work-board { min-height: 0; padding-block: 20px 14px; }
    .work-header { padding-bottom: 14px; }
    .work-header h2 { font-size: 2.4rem; }
    .project-list { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: repeat(3, minmax(82px, auto)); }
    .project-list li:nth-child(odd) { border-right: 1px solid var(--line); }
    .project {
      min-height: 82px;
      padding: 12px;
      grid-template-columns: 24px minmax(0, 1fr) 20px;
      grid-template-rows: auto auto;
      gap: 7px 6px;
      align-content: center;
    }
    .project-number { grid-row: 1 / 3; align-self: start; padding-top: 3px; }
    .project-name { font-size: clamp(1.25rem, 6vw, 1.7rem); line-height: .95; }
    .project-type { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 8px; }
    .project-year { display: none; }
    .project-arrow { grid-column: 3; grid-row: 1 / 3; align-self: center; }
    .work-footer { min-height: 40px; padding-top: 12px; font-size: 9px; }
    .work-footer p { display: none; }
    .work-footer a { margin-left: auto; }
  }

  @media (max-width: 360px) {
    .social-links a span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .social-links svg { width: 18px; height: 18px; }
    .project { padding-inline: 8px; grid-template-columns: 20px minmax(0, 1fr) 16px; }
    .project-name { font-size: 1.2rem; }
  }

  @media (min-width: 981px) and (max-height: 720px) {
    .topbar { height: 52px; }
    .portfolio { min-height: calc(100dvh - 52px); }
    .identity,
    .work-board { padding-block: 24px 20px; }
    .identity h1 { font-size: clamp(3.1rem, 4.6vw, 5rem); }
    .identity-footer { margin-top: 24px; }
    .work-header { padding-bottom: 14px; }
    .work-header h2 { font-size: 2.6rem; }
    .project-list { grid-template-rows: repeat(6, minmax(54px, 1fr)); }
    .project { min-height: 54px; }
    .work-footer { min-height: 44px; padding-top: 12px; }
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      scroll-behavior: auto !important;
      animation-duration: .01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: .01ms !important;
    }
  }

  @keyframes pageIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes boardIn {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
