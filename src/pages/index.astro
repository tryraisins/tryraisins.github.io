---
import '../styles/fonts.css';
import Play from '../prototypes/portfolio-redesign/Play.astro';
import BootOverlay from '../components/BootOverlay.astro';

import quickBillzCover from '../assets/images/quickbillz-cover.png';
import terrorTrackerCover from '../assets/images/terror-tracker-cover.png';
import talentHunterCover from '../assets/images/talent-hunter-cover.png';
import streamSlipCover from '../assets/images/streamslip-cover.png';
import slopLensCover from '../assets/images/sloplens-cover.png';

const projects = [
  { number: '01', name: 'Terror Tracker', type: 'Live incident map', description: 'A map for exploring verified security incidents and emerging patterns across Nigeria.', year: '2026', href: 'https://terrortracker.tryraisins.dev/', cover: terrorTrackerCover, coverAlt: 'Nigeria security incident tracker dashboard' },
  { number: '02', name: 'SlopLens', type: 'Design audit tool', description: 'Scores any web page out of 100 for how template-made it looks, and lists the tells that gave it away.', year: '2026', href: 'https://sloplens.tryraisins.dev/', cover: slopLensCover, coverAlt: 'SlopLens slop score checker' },
  { number: '03', name: 'QuickBillz', type: 'Invoicing product', description: 'A straightforward way to create and share invoices, without a monthly subscription.', year: '2026', href: 'https://quickbillz.tryraisins.dev/', cover: quickBillzCover, coverAlt: 'QuickBillz invoice workspace' },
  { number: '04', name: 'Talent Hunter', type: 'Resume matching', description: 'Compares resumes with a job brief to help teams build a clearer shortlist.', year: '2026', href: 'https://talenthunter.tryraisins.dev/', cover: talentHunterCover, coverAlt: 'Talent Hunter resume screening interface' },
  { number: '05', name: 'StreamSlip', type: 'Music utility', description: 'Turns YouTube Music listening history into a tidy recap you can share.', year: '2025', href: 'https://streamslip.vercel.app/', cover: streamSlipCover, coverAlt: 'StreamSlip music receipt interface' },
  { number: '06', name: 'yeknal', type: 'Developer tooling', description: 'A command-line tool and a library of agent skills that teach coding agents how I review, design, test and ship work.', year: '2026', href: '/skills/', cta: 'Browse the skills', cover: null, coverAlt: '', placeholder: 'terminal' },
  { number: '07', name: 'BetPicks', type: 'Sports picks product', description: 'A single place to look through fixtures, odds, and match predictions.', year: '2026', href: 'https://betpicks.tryraisins.dev/', cover: null, coverAlt: '', placeholder: 'slip', suspended: true },
];

const socials = [
  { name: 'GitHub', href: 'https://github.com/tryraisins' },
  { name: 'LinkedIn', href: 'https://www.linkedin.com/in/seun-sowemimo-8518b7249/' },
  { name: 'Medium', href: 'https://medium.com/@TryRaisins' },
];

const siteUrl = 'https://tryraisins.dev/';
const pageTitle = 'TryRaisins | Software Engineer in Lagos, Nigeria';
const pageDescription = 'TryRaisins is a Lagos-based software engineer building web products and developer tools, from the Terror Tracker incident map and SlopLens to QuickBillz invoicing, with React, TypeScript, Next.js, Node.js and Python.';
const socialImageAlt = 'TryRaisins: I build useful things for the web. Ruled notebook paper with a handwritten hello and pencil sketches of a face and a cat.';
// The LinkedIn URL spells out a personal name, so it stays a visible link on the
// page but is left out of the structured data.
const profileUrls = socials.filter((social) => social.name !== 'LinkedIn').map((social) => social.href);
const socialImage = `${siteUrl}og-notebook.png`;
const seoSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${siteUrl}#person`,
      name: 'TryRaisins',
      url: siteUrl,
      image: socialImage,
      jobTitle: 'Software engineer',
      description: pageDescription,
      homeLocation: { '@type': 'Place', name: 'Lagos, Nigeria' },
      sameAs: profileUrls,
      knowsAbout: ['React', 'TypeScript', 'Next.js', 'Node.js', 'Python', 'Web development', 'Developer tooling', 'AI coding agents'],
    },
    {
      '@type': 'Organization',
      '@id': `${siteUrl}#brand`,
      name: 'TryRaisins',
      url: siteUrl,
      logo: `${siteUrl}logo512.png`,
      founder: { '@id': `${siteUrl}#person` },
      sameAs: profileUrls,
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      url: siteUrl,
      name: 'TryRaisins',
      description: pageDescription,
      publisher: { '@id': `${siteUrl}#brand` },
    },
    {
      '@type': 'ProfilePage',
      '@id': `${siteUrl}#profile`,
      url: siteUrl,
      name: pageTitle,
      description: pageDescription,
      isPartOf: { '@id': `${siteUrl}#website` },
      mainEntity: { '@id': `${siteUrl}#person` },
    },
    {
      '@type': 'ItemList',
      '@id': `${siteUrl}#projects`,
      name: 'TryRaisins projects',
      itemListElement: projects.filter((project) => !project.suspended).map((project, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        item: {
          '@type': 'CreativeWork',
          name: project.name,
          description: project.description,
          url: new URL(project.href, siteUrl).href,
        },
      })),
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="theme-color" content="#fbfaf5" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content="TryRaisins" />
    <link rel="canonical" href={siteUrl} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:site_name" content="TryRaisins" />
    <meta property="og:locale" content="en_NG" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <meta name="twitter:creator" content="@tryraisins" />
    <script id="structured-data" type="application/ld+json" set:html={JSON.stringify(seoSchema)} />
    <link rel="preload" href="/fonts/bricolage-grotesque-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/dm-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/caveat-latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <BootOverlay />
    <Play projects={projects} socials={socials} email="tryraisins@gmail.com" />
  </body>
</html>

<style is:global>
  html { min-width: 320px; background: #e7ddc9; scroll-behavior: smooth; }
  body { min-width: 320px; min-height: 100dvh; margin: 0; overflow-x: hidden; background: #e7ddc9; }
  ::selection { background: #315fe9; color: #fff; }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
</style>
