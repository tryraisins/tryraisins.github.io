---
import '../styles/global.css';

import quickBillzCover from '../assets/images/quickbillz-cover.png';
import terrorTrackerCover from '../assets/images/terror-tracker-cover.png';
import talentHunterCover from '../assets/images/talent-hunter-cover.png';
import streamSlipCover from '../assets/images/streamslip-cover.png';

const projects = [
  { number: '01', name: 'QuickBillz', type: 'Product / Invoicing', description: 'A subscription-free invoicing tool for creating polished, shareable bills in seconds.', year: '2026', accent: '#ff5c35', href: 'https://quickbillz.tryraisins.dev/', cover: quickBillzCover, coverAlt: 'QuickBillz invoice workspace' },
  { number: '02', name: 'Terror Tracker', type: 'Live intelligence map', description: 'A live map of insurgent activity across Nigeria, built around verified incidents and threat clusters.', year: '2026', accent: '#b8ff32', href: 'https://terrortracker.tryraisins.dev/', cover: terrorTrackerCover, coverAlt: 'NATracker Nigeria attack tracker dashboard' },
  { number: '03', name: 'Talent Hunter', type: 'Applied NLP', description: 'A recruiter workflow that turns a job brief and a pile of resumes into a ranked shortlist.', year: '2026', accent: '#74a7ff', href: 'https://talenthunter.tryraisins.dev/', cover: talentHunterCover, coverAlt: 'Talent Hunter resume screening landing page' },
  { number: '04', name: 'yeknal', type: 'NPM CLI / Agent skills', description: 'A developer CLI for creating, packaging, and sharing reusable agent skills and project guidance.', year: '2026', accent: '#00c2a8', href: 'https://www.npmjs.com/package/yeknal' },
  { number: '05', name: 'StreamSlip', type: 'Music recap utility', description: 'Turns YouTube Music listening history into a shareable receipt with a clean, personal recap.', year: '2025', accent: '#ffcf40', href: 'https://streamslip.vercel.app/', cover: streamSlipCover, coverAlt: 'StreamSlip music receipts landing page' },
  { number: '06', name: 'BetPicks', type: 'Sports picks product', description: 'A focused sports-picks experience for exploring fixtures, odds, and informed predictions.', year: '2026', accent: '#ff78bd', href: 'https://betpicks.tryraisins.dev/' },
];

const games = [
  { key: '01', name: 'Glyph Serpent', note: 'An 8-bit snake run with classic wall and body collisions, apple pickups, speed ramps, and a persistent high score.' },
  { key: '02', name: 'Space Invaders', note: 'A hand-drawn alien armada with shifting formations, return fire from every surviving column, and escalating waves.' },
  { key: '03', name: 'Dino Run', note: 'A kinetic sunset sprint with a running dino, rolling dunes, drifting dust, and a desert that speeds up beneath your feet.' },
];

const leaderboardApiUrl = import.meta.env.PUBLIC_LEADERBOARD_API_URL ?? 'https://tryraisins-arcade-api.vercel.app/api/leaderboard';

const siteUrl = 'https://tryraisins.dev/';
const pageTitle = 'Seun Sowemimo (TryRaisins) — Fullstack Developer, Lagos';
const pageDescription = 'Seun Sowemimo, known as TryRaisins, is a Lagos-based fullstack developer building reliable web products with React, TypeScript, Node.js, and Python.';
const socialImage = `${siteUrl}og-image.png?v=2`;
const seoSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${siteUrl}#person`,
      name: 'Seun Sowemimo',
      alternateName: 'TryRaisins',
      url: siteUrl,
      image: socialImage,
      jobTitle: 'Fullstack Developer',
      description: pageDescription,
      email: 'mailto:tryraisins@gmail.com',
      homeLocation: { '@type': 'Place', name: 'Lagos, Nigeria' },
      sameAs: [
        'https://github.com/tryraisins',
        'https://www.linkedin.com/in/seun-sowemimo-8518b7249/',
        'https://medium.com/@TryRaisins',
      ],
      knowsAbout: ['React', 'TypeScript', 'JavaScript', 'Node.js', 'Python', 'Web development', 'Frontend development', 'Backend development'],
    },
    {
      '@type': 'Organization',
      '@id': `${siteUrl}#brand`,
      name: 'TryRaisins',
      url: siteUrl,
      founder: { '@id': `${siteUrl}#person` },
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      url: siteUrl,
      name: 'TryRaisins',
      description: pageDescription,
      publisher: { '@id': `${siteUrl}#brand` },
    },
    {
      '@type': 'ProfilePage',
      '@id': `${siteUrl}#profile`,
      url: siteUrl,
      name: pageTitle,
      description: pageDescription,
      isPartOf: { '@id': `${siteUrl}#website` },
      mainEntity: { '@id': `${siteUrl}#person` },
    },
    {
      '@type': 'ItemList',
      '@id': `${siteUrl}#projects`,
      name: 'TryRaisins projects',
      itemListElement: projects.map((project, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        item: {
          '@type': 'CreativeWork',
          name: project.name,
          description: `${project.type} project by TryRaisins`,
          ...(project.href ? { url: project.href } : {}),
        },
      })),
    },
  ],
};
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta id="theme-color" name="theme-color" content="#f0ede4" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content="TryRaisins" />
    <meta name="keywords" content="TryRaisins, fullstack developer, React developer, TypeScript developer, Node.js developer, Python developer, web developer portfolio" />
    <link rel="canonical" href={siteUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:site_name" content="TryRaisins" />
    <meta property="og:locale" content="en_NG" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="TryRaisins — Fullstack developer portfolio" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="TryRaisins — Fullstack developer portfolio" />
    <meta name="twitter:creator" content="@tryraisins" />
    <script id="structured-data" type="application/ld+json" set:html={JSON.stringify(seoSchema)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=DM+Mono:wght@300;400;500&family=Manrope:wght@400;500;600&display=swap" rel="stylesheet" />
    <script is:inline>if (location.hash.includes('figmacapture=')) document.documentElement.classList.add('figma-capture');</script>
    <script src="https://mcp.figma.com/mcp/html-to-design/capture.js" async></script>
  </head>
  <body>
    <div class="grain" aria-hidden="true"></div>
    <canvas class="systems-map" aria-hidden="true"></canvas>

    <nav class="nav-shell" aria-label="Concept navigation">
      <a class="brand" href="#top" aria-label="TryRaisins home">
        <span class="brand-dot"></span>
        TRYRAISINS
      </a>
      <div class="nav-links">
        <a href="#work">Work</a>
        <a href="#play">Play</a>
        <a href="#about">About</a>
        <a href="#contact">Contact</a>
      </div>
      <button class="theme-toggle" type="button" aria-label="Invert page colors" aria-pressed="false">
        <span class="theme-icon">◐</span>
        <span class="theme-label">Invert</span>
      </button>
    </nav>

    <main id="top">
      <section class="hero section-scene" data-section="hero" data-scheme="paper">
        <svg class="hero-line" viewBox="0 0 1200 720" preserveAspectRatio="none" aria-hidden="true">
          <path d="M-80 490 C120 200 230 705 410 390 S700 90 725 410 S995 720 1280 220" />
          <path class="line-echo" d="M-30 560 C200 370 320 700 510 450 S810 205 840 490 S1080 640 1240 350" />
        </svg>

        <h1 class="hero-kicker">
          <span>Seun Sowemimo / TryRaisins</span>
          <span>Fullstack developer</span>
          <span>Lagos, Nigeria</span>
        </h1>

        <div class="hero-title">
          <div class="title-row"><span>BUILDING</span><i>01</i></div>
          <div class="title-row title-shift"><span>THINGS</span><i>02</i></div>
          <div class="title-row title-outline"><span>THAT WORK.</span><i>03</i></div>
        </div>

        <div class="hero-foot">
          <p>I turn difficult ideas into fast, useful digital products—then hide a little mischief in the details.</p>
          <a class="round-link" href="#work" aria-label="See selected work"><span>↓</span></a>
        </div>
      </section>

      <section id="about" class="about section-scene" data-section="about" data-scheme="signal" aria-labelledby="about-title">
        <div class="about-topline">
          <p class="about-index">02 / About the builder</p>
        </div>
        <div class="cap-intro reveal">
          <div class="about-heading">
            <p class="eyebrow">How I work</p>
            <h2 id="about-title">ONE BUILDER.<br /><em>MANY SYSTEMS.</em></h2>
          </div>
          <p class="about-copy reveal">I'm TryRaisins - a fullstack developer who turns difficult ideas into useful products. I move from interface to infrastructure with the same question: does this make the work clearer, faster, or more human?</p>
        </div>
        <div class="cap-grid about-grid">
          <article class="cap-card reveal" style="--delay:0ms"><span>01 / Interface</span><h3>Make it felt.</h3><p>React · TypeScript · Motion · Accessibility</p><i>UI</i></article>
          <article class="cap-card reveal" style="--delay:80ms"><span>02 / Systems</span><h3>Make it hold.</h3><p>Node · APIs · Data · Architecture</p><i>API</i></article>
          <article class="cap-card reveal" style="--delay:160ms"><span>03 / Intelligence</span><h3>Make it think.</h3><p>Python · NLP · Automation · Search</p><i>AI</i></article>
          <article class="cap-card reveal" style="--delay:240ms"><span>04 / Delivery</span><h3>Make it real.</h3><p>Cloud · CI/CD · Observability · Scale</p><i>SHIP</i></article>
        </div>
        <div class="about-footer">
          <span>Interface - systems - delivery</span>
          <a class="about-work-link" href="#work">See the work <span class="link-arrow" aria-hidden="true"></span></a>
        </div>
      </section>

      <section id="work" class="work section-scene" data-section="work" data-scheme="warm">
        <header class="section-head reveal">
          <p class="eyebrow">Selected output / 2024—2026</p>
          <h2>WORK THAT<br /><em>EARNS</em> ATTENTION.</h2>
          <p class="head-note">The projects stay central. Motion supports the story; it never buries the proof.</p>
        </header>

        <div class="project-list">
          {projects.map((project) => (
            <article class:list={['project', 'reveal', { 'has-cover': project.cover }]} style={`--project-accent:${project.accent}`}>
              <a class="project-row-link" href={project.href ?? '#'} target={project.href ? '_blank' : undefined} rel={project.href ? 'noopener noreferrer' : undefined} aria-label={`Open ${project.name}`}></a>
              <span class="project-number">{project.number}</span>
              <span class="project-details">
                <span class="project-name">{project.name}</span>
                <span class="project-description">{project.description}</span>
              </span>
              <span class="project-meta">{project.type}</span>
              <span class="project-year">{project.year}</span>
              <a class="project-action" href={project.href ?? '#'} target={project.href ? '_blank' : undefined} rel={project.href ? 'noopener noreferrer' : undefined} aria-label={`Open ${project.name}`}>
                <span class="project-action-label">Open</span>
                <span class="project-arrow" aria-hidden="true"></span>
              </a>
              {project.cover && (
                <figure class="project-preview">
                  <span class="project-preview-frame">
                    <img src={project.cover.src} alt={project.coverAlt} loading="lazy" />
                  </span>
                </figure>
              )}
            </article>
          ))}
        </div>
      </section>

      <section id="play" class="play section-scene" data-section="play" data-scheme="ink">
        <div class="play-intro reveal">
          <p class="eyebrow">The page plays back</p>
          <h2>NOT AN ARCADE.<br />A LIVING <em>PORTFOLIO.</em></h2>
          <p>Games emerge from the section you are reading. The words, skills, and projects are the pieces—not decoration pasted over the work.</p>
        </div>

        <div class="game-stage reveal">
          <div class="stage-topbar">
            <span>Hidden systems / preview</span>
            <span class="stage-status"><i></i> section content detected</span>
          </div>
          <div class="snake-demo" aria-hidden="true">
            <div class="demo-copy">BUILD <span>DIGITAL</span> PRODUCTS WITH PURPOSE</div>
            <div class="snake">
              <i></i><i></i><i></i><i></i><i></i><i class="snake-head"></i>
            </div>
            <div class="food"><i></i></div>
          </div>
          <div class="stage-caption">
            <span>GLYPH SERPENT</span>
            <p>Guide a neon snake across the pixel grid. Eat fruit, grow longer, survive faster.</p>
          </div>
        </div>

        <div class="game-list">
          {games.map((game) => (
            <article class="game-card reveal">
              <span class="game-key">{game.key}</span>
              <h3>{game.name}</h3>
              <p>{game.note}</p>
              <button class="game-launch" type="button" data-game={game.name.toLowerCase().replace(/\s+/g, '-')}>Play this game <span class="link-arrow" aria-hidden="true"></span></button>
            </article>
          ))}
        </div>
        <div class="game-console" hidden aria-live="polite">
          <div class="console-topbar"><span class="console-kicker">Playable system / <b id="console-game-name">—</b></span><button class="console-close" type="button" aria-label="Close game">×</button></div>
          <p class="console-status" id="console-status">Choose a game to begin.</p>
          <form id="score-form" class="score-entry" hidden>
            <label for="score-name">You made the board. Save your arcade name.</label>
            <div class="score-form-row"><input id="score-name" name="name" type="text" maxlength="5" minlength="1" pattern="[A-Za-z0-9]{1,5}" autocomplete="off" placeholder="NAME" aria-describedby="score-form-hint" /><button type="submit">Save score</button></div>
            <small id="score-form-hint">1–5 letters or numbers · score <span id="score-form-score">0</span></small>
          </form>
          <canvas id="game-canvas" width="840" height="420" aria-label="Game canvas"></canvas>
          <div class="touch-controls" hidden aria-label="Game touch controls">
            <button type="button" data-control="up" aria-label="Move up">Up</button>
            <button type="button" data-control="left" aria-label="Move left">Left</button>
            <button type="button" data-control="right" aria-label="Move right">Right</button>
            <button type="button" data-control="down" aria-label="Move down">Down</button>
            <button type="button" data-control="fire" aria-label="Fire">Fire</button>
            <button type="button" data-control="jump" aria-label="Jump">Jump</button>
          </div>
          <div class="console-controls">Arrows / WASD move · P pauses · R restarts · F toggles fullscreen · Esc closes</div>
          <aside class="leaderboard-panel" data-api-url={leaderboardApiUrl} aria-live="polite">
            <div class="leaderboard-head"><span>Top 10 / <b id="leaderboard-game">—</b></span><span id="leaderboard-source">Board loading…</span></div>
            <ol id="leaderboard-list"><li>Choose a game to see the board.</li></ol>
          </aside>
        </div>
      </section>

      <section id="contact" class="contact section-scene" data-section="contact" data-scheme="contact" aria-labelledby="contact-title">
        <div class="contact-topline">
          <p>05 / Start a conversation</p>
          <p>Lagos, Nigeria · Available worldwide</p>
        </div>
        <div class="contact-center reveal">
          <p class="contact-kicker">Have a difficult idea?</p>
          <h2 id="contact-title">LET’S BUILD<br /><em>SOMETHING</em><br />THAT WORKS.</h2>
          <a class="contact-email" href="mailto:tryraisins@gmail.com">tryraisins@gmail.com <span class="link-arrow" aria-hidden="true"></span></a>
        </div>
        <div class="contact-footer">
          <p>Find TryRaisins elsewhere</p>
          <div class="contact-socials">
            <a href="https://github.com/tryraisins" target="_blank" rel="noopener noreferrer"><span>GitHub</span><i>Code / experiments</i><b class="link-arrow" aria-hidden="true"></b></a>
            <a href="https://www.linkedin.com/in/seun-sowemimo-8518b7249/" target="_blank" rel="noopener noreferrer"><span>LinkedIn</span><i>Professional profile</i><b class="link-arrow" aria-hidden="true"></b></a>
            <a href="https://medium.com/@TryRaisins" target="_blank" rel="noopener noreferrer"><span>Medium</span><i>Ideas / writing</i><b class="link-arrow" aria-hidden="true"></b></a>
          </div>
          <p>© {new Date().getFullYear()} TryRaisins</p>
        </div>
        <div class="contact-orbit" aria-hidden="true"><span>OPEN TO GOOD PROBLEMS · OPEN TO GOOD PEOPLE · </span></div>
      </section>
    </main>

    <script>
      const root = document.documentElement;
      const toggle = document.querySelector('.theme-toggle');

      const themeLabel = toggle?.querySelector('.theme-label');
      const themeColor = document.querySelector('#theme-color');
      const setTheme = (theme) => {
        const isInverted = theme === 'dark';
        root.dataset.theme = isInverted ? 'dark' : 'light';
        toggle?.setAttribute('aria-pressed', String(isInverted));
        toggle?.setAttribute('aria-label', isInverted ? 'Restore page colors' : 'Invert page colors');
        if (themeLabel) themeLabel.textContent = isInverted ? 'Restore' : 'Invert';
        if (themeColor instanceof HTMLMetaElement) themeColor.content = isInverted ? '#11110f' : '#f0ede4';
      };

      setTheme(root.dataset.theme);
      toggle?.addEventListener('click', () => {
        setTheme(root.dataset.theme === 'dark' ? 'light' : 'dark');
      });

      const mapCanvas = document.querySelector('.systems-map');
      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (mapCanvas instanceof HTMLCanvasElement) {
        const context = mapCanvas.getContext('2d');
        const labels = ['UI', 'API', 'DATA', 'SHIP', 'BUILD', 'PLAY', 'IDEA', 'USE'];
        let width = innerWidth;
        let height = innerHeight;
        let pointerX = width * .72;
        let pointerY = height * .35;
        let nodes = [];

        const resizeMap = () => {
          width = innerWidth;
          height = innerHeight;
          const ratio = Math.min(devicePixelRatio || 1, 1.6);
          mapCanvas.width = width * ratio;
          mapCanvas.height = height * ratio;
          mapCanvas.style.width = `${width}px`;
          mapCanvas.style.height = `${height}px`;
          context?.setTransform(ratio, 0, 0, ratio, 0, 0);
          nodes = labels.map((label, index) => ({
            label,
            x: (width / labels.length) * (index + .55),
            y: height * (.2 + ((index * 37) % 58) / 100),
            vx: ((index % 3) - 1) * .055,
            vy: ((index % 2) ? 1 : -1) * .045,
          }));
        };

        const drawMap = () => {
          if (!context) return;
          context.clearRect(0, 0, width, height);
          const ink = getComputedStyle(document.body).color;
          context.strokeStyle = ink;
          context.fillStyle = ink;
          context.globalAlpha = .16;
          context.lineWidth = 1;
          context.setLineDash([3, 8]);
          nodes.forEach((node, index) => {
            const next = nodes[(index + 1) % nodes.length];
            const pullX = (pointerX - node.x) * .00008;
            const pullY = (pointerY - node.y) * .00008;
            if (!reduceMotion) {
              node.x += node.vx + pullX;
              node.y += node.vy + pullY;
              if (node.x < 20 || node.x > width - 20) node.vx *= -1;
              if (node.y < 90 || node.y > height - 40) node.vy *= -1;
            }
            context.beginPath();
            context.moveTo(node.x, node.y);
            context.quadraticCurveTo((node.x + next.x) / 2, pointerY * .18 + height * .28, next.x, next.y);
            context.stroke();
            context.setLineDash([]);
            context.beginPath();
            context.arc(node.x, node.y, index % 2 ? 4 : 7, 0, Math.PI * 2);
            context.stroke();
            context.font = '9px DM Mono';
            context.fillText(node.label, node.x + 11, node.y + 3);
            context.setLineDash([3, 8]);
          });
          context.globalAlpha = 1;
          requestAnimationFrame(drawMap);
        };
        addEventListener('pointermove', (event) => { pointerX = event.clientX; pointerY = event.clientY; }, { passive: true });
        addEventListener('resize', resizeMap, { passive: true });
        resizeMap();
        drawMap();
      }

      const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            revealObserver.unobserve(entry.target);
          }
        });
      }, { threshold: .12 });
      document.querySelectorAll('.reveal').forEach((el) => revealObserver.observe(el));

      let activeSection = '';
      const scenes = [...document.querySelectorAll('.section-scene')];
      const switchScene = (section) => {
        const name = section.dataset.section || 'hero';
        if (name === activeSection) return;
        activeSection = name;
        root.dataset.scene = section.dataset.scheme || 'paper';
        const activeIndex = scenes.indexOf(section);
        scenes.forEach((item, index) => {
          item.classList.toggle('scene-active', item === section);
          item.classList.toggle('scene-before', index < activeIndex);
          item.classList.toggle('scene-after', index > activeIndex);
        });
      };

      const visibleSections = new Map();
      const sectionObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => visibleSections.set(entry.target, entry.intersectionRatio));
        const current = [...visibleSections.entries()].sort((a, b) => b[1] - a[1])[0];
        if (current?.[0] instanceof HTMLElement && current[1] > 0) switchScene(current[0]);
      }, { threshold: [0, .15, .35, .55, .75] });
      scenes.forEach((el) => sectionObserver.observe(el));
      const firstScene = document.querySelector('.section-scene');
      if (firstScene instanceof HTMLElement) switchScene(firstScene);

      // Playable section games. Each game exposes deterministic state hooks for testing.
      const gameConsole = document.querySelector('.game-console');
      const gameCanvas = document.querySelector('#game-canvas');
      const gameName = document.querySelector('#console-game-name');
      const gameStatus = document.querySelector('#console-status');
      const touchControls = document.querySelector('.touch-controls');
      const closeGame = document.querySelector('.console-close');
      let activeGameId = '';
      let stopActiveGame = () => {};
      let gameFrame = 0;
      const playText = () => (document.querySelector('#play')?.textContent || '').replace(/\s+/g, ' ');
      const setGameStatus = (message) => { if (gameStatus) gameStatus.textContent = message; };
      const setGameMode = (mode) => {
        if (gameCanvas instanceof HTMLCanvasElement) gameCanvas.hidden = mode !== 'canvas';
        if (touchControls instanceof HTMLElement) touchControls.hidden = mode !== 'canvas';
      };

      const leaderboardPanel = document.querySelector('.leaderboard-panel');
      const leaderboardGame = document.querySelector('#leaderboard-game');
      const leaderboardSource = document.querySelector('#leaderboard-source');
      const leaderboardList = document.querySelector('#leaderboard-list');
      const scoreForm = document.querySelector('#score-form');
      const scoreName = document.querySelector('#score-name');
      const scoreFormScore = document.querySelector('#score-form-score');
      const leaderboardApi = leaderboardPanel instanceof HTMLElement ? leaderboardPanel.dataset.apiUrl?.replace(/\/$/, '') || '' : '';
      const leaderboardLocalKey = 'tryraisins-arcade-leaderboards';
      let pendingScore = null;
      let activeLeaderboardGame = '';
      let leaderboardRows = [];

      const gameLabels = { 'glyph-serpent': 'Glyph Serpent', 'space-invaders': 'Space Invaders', 'dino-run': 'Dino Run' };
      const localBoards = () => {
        try { return JSON.parse(localStorage.getItem(leaderboardLocalKey) || '{}'); } catch { return {}; }
      };
