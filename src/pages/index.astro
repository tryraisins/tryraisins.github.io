---
import Play from '../prototypes/portfolio-redesign/Play.astro';

import quickBillzCover from '../assets/images/quickbillz-cover.png';
import terrorTrackerCover from '../assets/images/terror-tracker-cover.png';
import talentHunterCover from '../assets/images/talent-hunter-cover.png';
import streamSlipCover from '../assets/images/streamslip-cover.png';

const projects = [
  { number: '01', name: 'QuickBillz', type: 'Product / Invoicing', description: 'Create polished, shareable invoices without a subscription.', year: '2026', href: 'https://quickbillz.tryraisins.dev/', cover: quickBillzCover, coverAlt: 'QuickBillz invoice workspace' },
  { number: '02', name: 'Terror Tracker', type: 'Live intelligence map', description: 'Maps verified security incidents and threat patterns across Nigeria.', year: '2026', href: 'https://terrortracker.tryraisins.dev/', cover: terrorTrackerCover, coverAlt: 'Nigeria security incident tracker dashboard' },
  { number: '03', name: 'Talent Hunter', type: 'Applied NLP', description: 'Ranks resumes against a job brief for faster, clearer shortlists.', year: '2026', href: 'https://talenthunter.tryraisins.dev/', cover: talentHunterCover, coverAlt: 'Talent Hunter resume screening interface' },
  { number: '04', name: 'yeknal', type: 'NPM CLI / Agent skills', description: 'Packages reusable agent skills and project guidance from the command line.', year: '2026', href: 'https://www.npmjs.com/package/yeknal', cover: null, coverAlt: '' },
  { number: '05', name: 'StreamSlip', type: 'Music recap utility', description: 'Turns YouTube Music history into a clean, shareable listening receipt.', year: '2025', href: 'https://streamslip.vercel.app/', cover: streamSlipCover, coverAlt: 'StreamSlip music receipt interface' },
  { number: '06', name: 'BetPicks', type: 'Sports picks product', description: 'Brings fixtures, odds, and informed predictions into one focused view.', year: '2026', href: 'https://betpicks.tryraisins.dev/', cover: null, coverAlt: '' },
];

const socials = [
  { name: 'GitHub', href: 'https://github.com/tryraisins' },
  { name: 'LinkedIn', href: 'https://www.linkedin.com/in/seun-sowemimo-8518b7249/' },
  { name: 'Medium', href: 'https://medium.com/@TryRaisins' },
];

const siteUrl = 'https://tryraisins.dev/';
const pageTitle = 'Seun Sowemimo (TryRaisins) | Software Engineer, Lagos';
const pageDescription = 'Seun Sowemimo, known as TryRaisins, is a Lagos-based fullstack developer building reliable web products with React, TypeScript, Node.js, and Python.';
const socialImage = `${siteUrl}og-image.png?v=2`;
const seoSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${siteUrl}#person`,
      name: 'Seun Sowemimo',
      alternateName: 'TryRaisins',
      url: siteUrl,
      image: socialImage,
      jobTitle: 'Fullstack Developer',
      description: pageDescription,
      email: 'mailto:tryraisins@gmail.com',
      homeLocation: { '@type': 'Place', name: 'Lagos, Nigeria' },
      sameAs: socials.map((social) => social.href),
      knowsAbout: ['React', 'TypeScript', 'JavaScript', 'Node.js', 'Python', 'Web development', 'Frontend development', 'Backend development'],
    },
    {
      '@type': 'Organization',
      '@id': `${siteUrl}#brand`,
      name: 'TryRaisins',
      url: siteUrl,
      founder: { '@id': `${siteUrl}#person` },
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      url: siteUrl,
      name: 'TryRaisins',
      description: pageDescription,
      publisher: { '@id': `${siteUrl}#brand` },
    },
    {
      '@type': 'ProfilePage',
      '@id': `${siteUrl}#profile`,
      url: siteUrl,
      name: pageTitle,
      description: pageDescription,
      isPartOf: { '@id': `${siteUrl}#website` },
      mainEntity: { '@id': `${siteUrl}#person` },
    },
    {
      '@type': 'ItemList',
      '@id': `${siteUrl}#projects`,
      name: 'TryRaisins projects',
      itemListElement: projects.map((project, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        item: {
          '@type': 'CreativeWork',
          name: project.name,
          description: `${project.type} project by TryRaisins`,
          url: project.href,
        },
      })),
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="theme-color" content="#fbfaf5" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content="TryRaisins" />
    <meta name="keywords" content="TryRaisins, fullstack developer, React developer, TypeScript developer, Node.js developer, Python developer, web developer portfolio" />
    <link rel="canonical" href={siteUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:site_name" content="TryRaisins" />
    <meta property="og:locale" content="en_NG" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="TryRaisins software engineer portfolio" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="TryRaisins software engineer portfolio" />
    <meta name="twitter:creator" content="@tryraisins" />
    <script id="structured-data" type="application/ld+json" set:html={JSON.stringify(seoSchema)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500&family=Space+Grotesk:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <Play projects={projects} socials={socials} email="tryraisins@gmail.com" />
  </body>
</html>

<style is:global>
  html { min-width: 320px; background: #d8d8d2; scroll-behavior: smooth; }
  body { min-width: 320px; min-height: 100dvh; margin: 0; overflow-x: hidden; background: #d8d8d2; }
  ::selection { background: #315fe9; color: #fff; }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
</style>
