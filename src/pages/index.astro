---
import '../styles/fonts.css';
import Play from '../prototypes/portfolio-redesign/Play.astro';
import BootOverlay from '../components/BootOverlay.astro';

import quickBillzCover from '../assets/images/quickbillz-cover.png';
import terrorTrackerCover from '../assets/images/terror-tracker-cover.png';
import talentHunterCover from '../assets/images/talent-hunter-cover.png';
import streamSlipCover from '../assets/images/streamslip-cover.png';
import slopLensCover from '../assets/images/sloplens-cover.png';

import type { ImageMetadata } from 'astro';
import { projects as projectFacts, socials, siteUrl, pageTitle, pageDescription, socialImageAlt, email } from '../data/profile';

// Covers stay beside the image imports; every wording fact about a project lives
// in src/data/profile.ts so the markdown alternate states the same thing.
const covers: Record<string, { cover: ImageMetadata | null; coverAlt: string; placeholder?: string }> = {
  'Terror Tracker': { cover: terrorTrackerCover, coverAlt: 'Nigeria security incident tracker dashboard' },
  SlopLens: { cover: slopLensCover, coverAlt: 'SlopLens slop score checker' },
  QuickBillz: { cover: quickBillzCover, coverAlt: 'QuickBillz invoice workspace' },
  'Talent Hunter': { cover: talentHunterCover, coverAlt: 'Talent Hunter resume screening interface' },
  StreamSlip: { cover: streamSlipCover, coverAlt: 'StreamSlip music receipt interface' },
  yeknal: { cover: null, coverAlt: '', placeholder: 'terminal' },
  BetPicks: { cover: null, coverAlt: '', placeholder: 'slip' },
};

const projects = projectFacts.map((project) => ({ ...project, ...covers[project.name] }));

// The LinkedIn URL spells out a personal name, so it stays a visible link on the
// page but is left out of the structured data.
const profileUrls = socials.filter((social) => social.name !== 'LinkedIn').map((social) => social.href);
const socialImage = `${siteUrl}og-notebook.png`;
const seoSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${siteUrl}#person`,
      name: 'TryRaisins',
      url: siteUrl,
      image: socialImage,
      jobTitle: 'Software engineer',
      description: pageDescription,
      sameAs: profileUrls,
      knowsAbout: ['React', 'TypeScript', 'Next.js', 'Node.js', 'Python', 'Web development', 'Developer tooling', 'AI coding agents'],
    },
    {
      '@type': 'Organization',
      '@id': `${siteUrl}#brand`,
      name: 'TryRaisins',
      url: siteUrl,
      logo: `${siteUrl}logo512.png`,
      founder: { '@id': `${siteUrl}#person` },
      sameAs: profileUrls,
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      url: siteUrl,
      name: 'TryRaisins',
      description: pageDescription,
      publisher: { '@id': `${siteUrl}#brand` },
    },
    {
      '@type': 'ProfilePage',
      '@id': `${siteUrl}#profile`,
      url: siteUrl,
      name: pageTitle,
      description: pageDescription,
      isPartOf: { '@id': `${siteUrl}#website` },
      mainEntity: { '@id': `${siteUrl}#person` },
    },
    {
      '@type': 'ItemList',
      '@id': `${siteUrl}#projects`,
      name: 'TryRaisins projects',
      itemListElement: projects.filter((project) => !project.suspended).map((project, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        item: {
          '@type': 'CreativeWork',
          name: project.name,
          description: project.description,
          url: new URL(project.href, siteUrl).href,
        },
      })),
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="theme-color" content="#f8f7f1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content="TryRaisins" />
    <link rel="canonical" href={siteUrl} />
    <link rel="alternate" type="text/markdown" href={`${siteUrl}index.md`} />
    <meta name="ai-summary" content={`${pageDescription} The page lists seven selected projects, six of them live, and links to a free library of agent skills for coding agents.`} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:site_name" content="TryRaisins" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <meta name="twitter:creator" content="@tryraisins" />
    <script id="structured-data" type="application/ld+json" set:html={JSON.stringify(seoSchema)} />
    <link rel="preload" href="/fonts/caveat-latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <BootOverlay />
    <Play projects={projects} socials={socials} email={email} />
  </body>
</html>

<style is:global>
  html { min-width: 320px; background: #f8f7f1; scroll-behavior: smooth; }
  body { min-width: 320px; min-height: 100dvh; margin: 0; overflow-x: hidden; background: #f8f7f1; }
  ::selection { background: #315fe9; color: #fff; }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
</style>
