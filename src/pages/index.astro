---
import '../styles/global.css';
import { Picture } from 'astro:assets';

import quickBillzCover from '../assets/images/quickbillz-cover.png';
import terrorTrackerCover from '../assets/images/terror-tracker-cover.png';
import talentHunterCover from '../assets/images/talent-hunter-cover.png';
import streamSlipCover from '../assets/images/streamslip-cover.png';

const projects = [
  { number: '01', name: 'QuickBillz', type: 'Product / Invoicing', description: 'A subscription-free invoicing tool for creating polished, shareable bills in seconds.', year: '2026', href: 'https://quickbillz.tryraisins.dev/', cover: quickBillzCover, coverAlt: 'QuickBillz invoice workspace' },
  { number: '02', name: 'Terror Tracker', type: 'Live intelligence map', description: 'A live map of insurgent activity across Nigeria, built around verified incidents and threat clusters.', year: '2026', href: 'https://terrortracker.tryraisins.dev/', cover: terrorTrackerCover, coverAlt: 'NATracker Nigeria attack tracker dashboard' },
  { number: '03', name: 'Talent Hunter', type: 'Applied NLP', description: 'A recruiter workflow that turns a job brief and a pile of resumes into a ranked shortlist.', year: '2026', href: 'https://talenthunter.tryraisins.dev/', cover: talentHunterCover, coverAlt: 'Talent Hunter resume screening landing page' },
  { number: '04', name: 'yeknal', type: 'NPM CLI / Agent skills', description: 'A developer CLI for creating, packaging, and sharing reusable agent skills and project guidance.', year: '2026', href: 'https://www.npmjs.com/package/yeknal' },
  { number: '05', name: 'StreamSlip', type: 'Music recap utility', description: 'Turns YouTube Music listening history into a shareable receipt with a clean, personal recap.', year: '2025', href: 'https://streamslip.vercel.app/', cover: streamSlipCover, coverAlt: 'StreamSlip music receipts landing page' },
  { number: '06', name: 'BetPicks', type: 'Sports picks product', description: 'A focused sports-picks experience for exploring fixtures, odds, and informed predictions.', year: '2026', href: 'https://betpicks.tryraisins.dev/' },
];

const games = [
  { key: '01', id: 'glyph-serpent', name: 'Glyph Serpent', note: 'Eat, grow, and stay clear of your own trail as the grid gets quicker.', format: 'Endless run', controls: 'Arrows or WASD', detail: 'Speed rises every 3 apples' },
  { key: '02', id: 'space-invaders', name: 'Space Invaders', note: 'Hold the line against a hand-drawn armada that descends with every sweep.', format: 'Wave defence', controls: 'Move and fire', detail: '4 rows / escalating waves' },
  { key: '03', id: 'dino-run', name: 'Dino Run', note: 'Time each jump as the sunset desert accelerates beneath your feet.', format: 'Distance run', controls: 'Space or arrow up', detail: 'Reactive pace / obstacles' },
];

const leaderboardApiUrl = import.meta.env.PUBLIC_LEADERBOARD_API_URL ?? 'https://tryraisins-arcade-api.vercel.app/api/leaderboard';

const siteUrl = 'https://tryraisins.dev/';
const pageTitle = 'Seun Sowemimo (TryRaisins) | Software Engineer, Lagos';
const pageDescription = 'Seun Sowemimo, known as TryRaisins, is a Lagos-based fullstack developer building reliable web products with React, TypeScript, Node.js, and Python.';
const socialImage = `${siteUrl}og-image.png?v=2`;
const seoSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${siteUrl}#person`,
      name: 'Seun Sowemimo',
      alternateName: 'TryRaisins',
      url: siteUrl,
      image: socialImage,
      jobTitle: 'Fullstack Developer',
      description: pageDescription,
      email: 'mailto:tryraisins@gmail.com',
      homeLocation: { '@type': 'Place', name: 'Lagos, Nigeria' },
      sameAs: [
        'https://github.com/tryraisins',
        'https://www.linkedin.com/in/seun-sowemimo-8518b7249/',
        'https://medium.com/@TryRaisins',
      ],
      knowsAbout: ['React', 'TypeScript', 'JavaScript', 'Node.js', 'Python', 'Web development', 'Frontend development', 'Backend development'],
    },
    {
      '@type': 'Organization',
      '@id': `${siteUrl}#brand`,
      name: 'TryRaisins',
      url: siteUrl,
      founder: { '@id': `${siteUrl}#person` },
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      url: siteUrl,
      name: 'TryRaisins',
      description: pageDescription,
      publisher: { '@id': `${siteUrl}#brand` },
    },
    {
      '@type': 'ProfilePage',
      '@id': `${siteUrl}#profile`,
      url: siteUrl,
      name: pageTitle,
      description: pageDescription,
      isPartOf: { '@id': `${siteUrl}#website` },
      mainEntity: { '@id': `${siteUrl}#person` },
    },
    {
      '@type': 'ItemList',
      '@id': `${siteUrl}#projects`,
      name: 'TryRaisins projects',
      itemListElement: projects.map((project, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        item: {
          '@type': 'CreativeWork',
          name: project.name,
          description: `${project.type} project by TryRaisins`,
          ...(project.href ? { url: project.href } : {}),
        },
      })),
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta id="theme-color" name="theme-color" content="#17130f" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content="TryRaisins" />
    <meta name="keywords" content="TryRaisins, fullstack developer, React developer, TypeScript developer, Node.js developer, Python developer, web developer portfolio" />
    <link rel="canonical" href={siteUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:site_name" content="TryRaisins" />
    <meta property="og:locale" content="en_NG" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="TryRaisins software engineer portfolio" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="TryRaisins software engineer portfolio" />
    <meta name="twitter:creator" content="@tryraisins" />
    <script id="structured-data" type="application/ld+json" set:html={JSON.stringify(seoSchema)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@500&family=DM+Mono:wght@300;400;500&family=Manrope:wght@400;500;600&family=Newsreader:opsz,wght@6..72,400;6..72,500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip-link" href="#work">Skip to selected work</a>
    <div class="grain" aria-hidden="true"></div>

    <nav class="nav-shell" aria-label="Primary navigation">
      <a class="brand" href="#top" aria-label="TryRaisins home">TryRaisins</a>
      <div class="nav-links">
        <a href="#work">Work</a>
        <a href="#about">About</a>
        <a href="#contact">Contact</a>
        <a class="nav-play" href="#play">Play</a>
      </div>
      <a class="nav-email" href="mailto:tryraisins@gmail.com">Say hello</a>
    </nav>

    <main id="top">
      <section id="about" class="hero reveal" aria-labelledby="hero-title">
        <div class="hero-rule" aria-hidden="true"></div>
        <div class="hero-content">
          <p class="eyebrow">Software engineer / Lagos, Nigeria</p>
          <h1 id="hero-title">I’m TryRaisins,<br />a software engineer.</h1>
          <div class="hero-support">
            <p>I turn difficult ideas into useful products.</p>
            <span class="work-note" aria-hidden="true">careful work, shipped.</span>
          </div>
          <footer class="hero-footer">
            <span>Building for clarity, scale, and real use.</span>
            <a href="#work">See the work <span class="link-arrow" aria-hidden="true"></span></a>
          </footer>
        </div>
      </section>

      <section id="work" class="work reveal" aria-labelledby="work-title">
        <header class="section-head">
          <div class="section-title-block">
            <p class="eyebrow">Selected output / 2024 to 2026</p>
            <h2 id="work-title">Selected work.</h2>
          </div>
          <div class="section-head-side">
            <span class="section-count" aria-hidden="true">01 / 06</span>
            <p class="head-note">Products, interfaces, and systems made useful.</p>
          </div>
        </header>

        <div class="project-list" aria-label="Selected projects">
          {projects.map((project) => (
            <article class:list={['project', { 'has-cover': project.cover }]}>
              <a class="project-row-link" href={project.href ?? '#'} target={project.href ? '_blank' : undefined} rel={project.href ? 'noopener noreferrer' : undefined} aria-label={`Open ${project.name}`}></a>
              <span class="project-number">{project.number}</span>
              <span class="project-details">
                <span class="project-name">{project.name}</span>
                <span class="project-description">{project.description}</span>
                <span class="project-info">
                  <span class="project-meta">{project.type}</span>
                  <span class="project-year">{project.year}</span>
                </span>
              </span>
              <a class="project-action" href={project.href ?? '#'} target={project.href ? '_blank' : undefined} rel={project.href ? 'noopener noreferrer' : undefined} aria-label={`Open ${project.name}`}>
                <span class="project-action-label">Open</span>
                <span class="project-arrow" aria-hidden="true"></span>
              </a>
              {project.cover && (
                <figure class="project-preview" aria-busy="true">
                  <span class="project-preview-frame">
                    <span class="project-preview-skeleton" aria-hidden="true"></span>
                    <Picture
                      src={project.cover}
                      alt={project.coverAlt}
                      widths={[480, 720, 960]}
                      sizes="(max-width: 800px) calc(100vw - 48px), min(23vw, 320px)"
                      formats={['avif', 'webp']}
                      loading="lazy"
                      class="project-cover-image"
                    />
                    <figcaption>Interface preview</figcaption>
                  </span>
                </figure>
              )}
            </article>
          ))}
        </div>

        <footer class="work-footer">
          <span>Six shipped systems. More are taking shape.</span>
          <a href="#contact">A little about how I work <span class="link-arrow" aria-hidden="true"></span></a>
        </footer>
      </section>

      <section id="contact" class="contact reveal" aria-labelledby="contact-title">
        <div class="contact-copy">
          <p class="eyebrow">A short note</p>
          <h2 id="contact-title">The work is here.<br />So am I.</h2>
          <p class="contact-intro">I like difficult problems, direct collaboration, and software that earns its place in someone’s day. If that sounds useful, send me a note.</p>
        </div>
        <div class="contact-actions">
          <a class="contact-email" href="mailto:tryraisins@gmail.com">tryraisins@gmail.com <span class="link-arrow" aria-hidden="true"></span></a>
          <div class="contact-socials" aria-label="Social links">
            <a href="https://github.com/tryraisins" target="_blank" rel="noopener noreferrer">GitHub</a>
            <a href="https://www.linkedin.com/in/seun-sowemimo-8518b7249/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
            <a href="https://medium.com/@TryRaisins" target="_blank" rel="noopener noreferrer">Medium</a>
          </div>
          <div class="contact-meta">
            <span>Lagos, Nigeria</span>
            <span>Available worldwide</span>
          </div>
        </div>
      </section>

      <section id="play" class="play" aria-labelledby="play-title">
        <header class="play-intro reveal">
          <div>
            <p class="eyebrow">After hours / desktop only</p>
            <h2 id="play-title">Three small games.</h2>
          </div>
          <p>Built by hand for this page. Pick one, learn the rhythm, and leave your name on the board.</p>
        </header>

        <div class="game-list" aria-label="Playable games">
          {games.map((game) => (
            <article class="game-card reveal" data-game-card={game.id}>
              <div class="game-card-top">
                <span class="game-key">{game.key}</span>
                <span class="game-format">{game.format}</span>
              </div>
              <div class={`game-mark game-mark-${game.id}`} aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
              <div class="game-card-copy">
                <h3>{game.name}</h3>
                <p>{game.note}</p>
              </div>
              <dl class="game-facts">
                <div><dt>Controls</dt><dd>{game.controls}</dd></div>
                <div><dt>Run</dt><dd>{game.detail}</dd></div>
              </dl>
              <button class="game-launch" type="button" data-game={game.id} aria-controls="game-console">Start game <span class="link-arrow" aria-hidden="true"></span></button>
            </article>
          ))}
        </div>

        <div id="game-console" class="game-console" hidden aria-live="polite">
          <div class="console-topbar">
            <span class="console-kicker">Now playing / <b id="console-game-name">None selected</b></span>
            <div class="console-actions">
              <button class="console-pause" type="button">Play / pause</button>
              <button class="console-restart" type="button">Restart</button>
              <button class="console-close" type="button" aria-label="Close game">Close</button>
            </div>
          </div>
          <p class="console-status" id="console-status">Choose a game to begin.</p>
          <div class="console-body">
            <div class="console-screen">
              <form id="score-form" class="score-entry" hidden>
                <label for="score-name">You made the board. Save your arcade name.</label>
                <div class="score-form-row"><input id="score-name" name="name" type="text" maxlength="5" minlength="1" pattern="[A-Za-z0-9]{1,5}" autocomplete="off" placeholder="NAME" aria-describedby="score-form-hint" /><button type="submit">Save score</button></div>
                <small id="score-form-hint">1 to 5 letters or numbers · score <span id="score-form-score">0</span></small>
              </form>
              <canvas id="game-canvas" width="840" height="420" tabindex="0" aria-label="Playable game. Keyboard controls are listed below."></canvas>
              <div class="touch-controls" hidden aria-label="Game touch controls">
                <button type="button" data-control="up" aria-label="Move up">Up</button>
                <button type="button" data-control="left" aria-label="Move left">Left</button>
                <button type="button" data-control="right" aria-label="Move right">Right</button>
                <button type="button" data-control="down" aria-label="Move down">Down</button>
                <button type="button" data-control="fire" aria-label="Fire">Fire</button>
                <button type="button" data-control="jump" aria-label="Jump">Jump</button>
              </div>
              <div class="console-controls">Arrows or WASD move · P pauses · R restarts · F toggles fullscreen · Esc closes</div>
            </div>
            <aside class="leaderboard-panel" data-api-url={leaderboardApiUrl} aria-live="polite">
              <div class="leaderboard-head"><span>Top 10 / <b id="leaderboard-game">No game</b></span><span id="leaderboard-source">Board loading…</span></div>
              <ol id="leaderboard-list"><li>Choose a game to see the board.</li></ol>
            </aside>
          </div>
        </div>
        <footer class="site-footer">
          <span>© {new Date().getFullYear()} TryRaisins</span>
          <a href="#top">Back to top</a>
        </footer>
      </section>
    </main>

    <script>
      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduceMotion || !('IntersectionObserver' in window)) {
        document.querySelectorAll('.reveal').forEach((element) => element.classList.add('is-visible'));
      } else {
        const revealObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            revealObserver.unobserve(entry.target);
          });
        }, { threshold: .08, rootMargin: '0px 0px -6% 0px' });
        document.querySelectorAll('.reveal').forEach((element) => revealObserver.observe(element));
      }

      document.querySelectorAll('.project-preview').forEach((preview) => {
        const image = preview.querySelector('img');
        if (!(image instanceof HTMLImageElement)) return;
        const markImageReady = () => {
          preview.classList.add('is-loaded');
          preview.removeAttribute('aria-busy');
        };
        image.addEventListener('load', markImageReady, { once: true });
        image.addEventListener('error', markImageReady, { once: true });
        if (image.complete) markImageReady();
      });

      // Playable section games. Each game exposes deterministic state hooks for testing.
      const gameConsole = document.querySelector('.game-console');
      const gameCanvas = document.querySelector('#game-canvas');
      const gameName = document.querySelector('#console-game-name');
      const gameStatus = document.querySelector('#console-status');
      const touchControls = document.querySelector('.touch-controls');
      const closeGame = document.querySelector('.console-close');
      const pauseGame = document.querySelector('.console-pause');
      const restartGame = document.querySelector('.console-restart');
      let activeGameId = '';
      let stopActiveGame = () => {};
      let gameFrame = 0;
      let gameSession = 0;
      const playText = () => (document.querySelector('#play')?.textContent || '').replace(/\s+/g, ' ');
      const setGameStatus = (message) => { if (gameStatus) gameStatus.textContent = message; };
      const setGameMode = (mode) => {
        if (gameCanvas instanceof HTMLCanvasElement) gameCanvas.hidden = mode !== 'canvas';
        if (touchControls instanceof HTMLElement) touchControls.hidden = mode !== 'canvas';
      };

      const leaderboardPanel = document.querySelector('.leaderboard-panel');
      const leaderboardGame = document.querySelector('#leaderboard-game');
      const leaderboardSource = document.querySelector('#leaderboard-source');
      const leaderboardList = document.querySelector('#leaderboard-list');
      const scoreForm = document.querySelector('#score-form');
      const scoreName = document.querySelector('#score-name');
      const scoreFormScore = document.querySelector('#score-form-score');
      const leaderboardApi = leaderboardPanel instanceof HTMLElement ? leaderboardPanel.dataset.apiUrl?.replace(/\/$/, '') || '' : '';
      const leaderboardLocalKey = 'tryraisins-arcade-leaderboards';
      let pendingScore = null;
      let activeLeaderboardGame = '';
      let leaderboardRows = [];

      const gameLabels = { 'glyph-serpent': 'Glyph Serpent', 'space-invaders': 'Space Invaders', 'dino-run': 'Dino Run' };
      const localBoards = () => {
        try {
          const boards = JSON.parse(localStorage.getItem(leaderboardLocalKey) || '{}');
          return boards && typeof boards === 'object' && !Array.isArray(boards) ? boards : {};
        } catch { return {}; }
      };
      const sortScores = (rows) => [...rows].sort((a, b) => Number(b.score) - Number(a.score) || Number(b.level) - Number(a.level)).slice(0, 10);
      const renderLeaderboard = (game, rows, source = '') => {
        leaderboardRows = sortScores(Array.isArray(rows) ? rows : []);
        activeLeaderboardGame = game;
        if (leaderboardGame) leaderboardGame.textContent = gameLabels[game] || game;
        if (leaderboardSource) leaderboardSource.textContent = source || (leaderboardApi ? 'ONLINE BOARD' : 'LOCAL PREVIEW');
        if (leaderboardList) {
          leaderboardList.replaceChildren();
          if (!leaderboardRows.length) {
            const empty = document.createElement('li');
            empty.textContent = 'No scores yet. Take the first slot.';
            leaderboardList.append(empty);
          } else {
            leaderboardRows.forEach((row, index) => {
              const item = document.createElement('li');
              const player = document.createElement('span');
              const score = document.createElement('b');
              const level = document.createElement('small');
              player.textContent = `${String(index + 1).padStart(2, '0')} ${String(row.name || '-----').replace(/[^a-z0-9]/gi, '').slice(0, 5).toUpperCase() || '-----'}`;
              score.textContent = String(Number(row.score) || 0);
              level.textContent = `LV ${Number(row.level) || 1}`;
              item.append(player, score, level);
              leaderboardList.append(item);
            });
          }
        }
      };
      const fetchLeaderboard = async (game) => {
        const local = localBoards()[game] || [];
        if (!leaderboardApi) { renderLeaderboard(game, local, 'LOCAL PREVIEW'); return local; }
        try {
          const response = await fetch(`${leaderboardApi}?game=${encodeURIComponent(game)}`);
          if (!response.ok) throw new Error(`Leaderboard request failed: ${response.status}`);
          const rows = await response.json(); renderLeaderboard(game, rows, 'ONLINE BOARD'); return rows;
        } catch (error) { console.info('Leaderboard unavailable; using local preview.', error); renderLeaderboard(game, local, 'LOCAL FALLBACK'); return local; }
      };
      const qualifiesForBoard = (score) => Number(score) > 0 && (leaderboardRows.length < 10 || Number(score) > Number(leaderboardRows[leaderboardRows.length - 1]?.score || 0));
      const offerScoreSave = async (game, score, level) => {
        const session = gameSession;
        await fetchLeaderboard(game);
        if (session !== gameSession || game !== activeGameId || !qualifiesForBoard(score) || !scoreForm) return;
        pendingScore = { game, score, level };
        scoreForm.hidden = false;
        if (scoreFormScore) scoreFormScore.textContent = String(score);
        if (scoreName instanceof HTMLInputElement) { scoreName.value = ''; window.setTimeout(() => scoreName.focus(), 0); }
        setGameStatus(`Top 10 score: ${score}. Save a 1–5 character arcade name.`);
      };
      const saveLeaderboardScore = async (entry) => {
        const name = String(entry.name || '').replace(/[^a-z0-9]/gi, '').slice(0, 5).toUpperCase();
        if (!name) return;
        const cleanEntry = { game: entry.game, name, score: Number(entry.score) || 0, level: Number(entry.level) || 1 };
        let savedOnline = false;
        if (leaderboardApi) {
          try {
            const response = await fetch(leaderboardApi, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(cleanEntry) });
            if (!response.ok) throw new Error(`Leaderboard save failed: ${response.status}`);
            savedOnline = true;
          } catch (error) { console.info('Online score save failed; saving locally.', error); }
        }
        const boards = localBoards(); boards[cleanEntry.game] = sortScores([...(boards[cleanEntry.game] || []), cleanEntry]); localStorage.setItem(leaderboardLocalKey, JSON.stringify(boards));
        if (scoreForm) scoreForm.hidden = true; pendingScore = null; renderLeaderboard(cleanEntry.game, savedOnline ? await fetchLeaderboard(cleanEntry.game) : boards[cleanEntry.game], savedOnline ? 'ONLINE BOARD' : 'LOCAL PREVIEW');
        setGameStatus(`${cleanEntry.name} saved at ${cleanEntry.score}. Keep climbing.`);
      };
      scoreForm?.addEventListener('submit', (event) => { event.preventDefault(); if (pendingScore && scoreName instanceof HTMLInputElement) saveLeaderboardScore({ ...pendingScore, name: scoreName.value }); });
      const finishScore = (game, score, level, message) => { setGameStatus(`${message} Score ${score}, level ${level}.`); void offerScoreSave(game, score, level); };
      const setTouchLayout = (game) => { touchControls?.querySelectorAll('[data-control]').forEach((button) => { const control = button.dataset.control; const visible = game === 'glyph-serpent' ? ['up', 'left', 'right', 'down'].includes(control) : game === 'space-invaders' ? ['left', 'right', 'fire'].includes(control) : control === 'jump'; button.hidden = !visible; }); };


      function startSnake() {
        stopActiveGame(); setGameMode('canvas'); setTouchLayout('glyph-serpent');
        if (!(gameCanvas instanceof HTMLCanvasElement)) return;
        const ctx = gameCanvas.getContext('2d'); if (!ctx) return;
        const cols = 28, rows = 16, hudHeight = 38, cellW = gameCanvas.width / cols, cellH = (gameCanvas.height - hudHeight) / rows;
        const highScoreKey = 'tryraisins-glyph-serpent-high-score';
        const storedHighScore = Number.parseInt(localStorage.getItem(highScoreKey) || '0', 10);
        const state = {
          mode: 'paused',
          snake: [{ x: 13, y: 8 }, { x: 12, y: 8 }, { x: 11, y: 8 }],
          dir: { x: 1, y: 0 }, queued: { x: 1, y: 0 }, foodPos: { x: 20, y: 8 }, score: 0,
          highScore: Number.isFinite(storedHighScore) ? storedHighScore : 0, foodSeed: 0, particles: [], last: 0, stepMs: 132,
        };
        const occupied = () => new Set(state.snake.map((part) => `${part.x},${part.y}`));
        const placeFood = () => {
          const taken = occupied();
          for (let attempt = 0; attempt < cols * rows; attempt++) {
            state.foodSeed += 1;
            const x = (state.foodSeed * 11 + 5 + attempt * 3) % cols;
