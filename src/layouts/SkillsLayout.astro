---
// Shell for /skills/ pages. Tokens, notebook rules and control styles mirror
// src/prototypes/portfolio-redesign/Play.astro so the library reads as part of
// the same notebook.
import { SITE_URL } from '../lib/skill-prompt';
import BootOverlay from '../components/BootOverlay.astro';
import '../styles/fonts.css';

interface Props {
  title: string;
  description: string;
  path: string;
  schema?: object;
  noindex?: boolean;
  current?: 'library' | 'skill';
  aiSummary?: string;
}

const { title, description, path, schema, noindex = false, current = 'skill', aiSummary } = Astro.props;
const canonical = new URL(path, SITE_URL).href;
// `/skills/` resolves to `/skills.md` and `/skills/<slug>/` to `/skills/<slug>.md`,
// which is the route src/pages/skills/[slug].md.ts and skills.md.ts publish.
const markdownHref = new URL(`${path.replace(/\/$/, '')}.md`, SITE_URL).href;
const summary = aiSummary ?? description;
const socialImage = `${SITE_URL}/og-skills.png`;
const socialAlt = 'Agent skills by TryRaisins: Skills that teach your coding agent a specific job, on ruled notebook paper with two yellow task notes.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    <meta name="theme-color" content="#f8f7f1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!noindex && <link rel="alternate" type="text/markdown" href={markdownHref} />}
    <meta name="ai-summary" content={summary} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="TryRaisins" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialAlt} />
    <meta name="twitter:creator" content="@tryraisins" />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
    <link rel="preload" href="/fonts/caveat-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/dm-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    <slot name="head" />
  </head>
  <body>
    <BootOverlay />
    <div class="sk-world">
      <a class="sk-skip" href="#sk-main">Skip to content</a>
      <header class="sk-topbar">
        <a class="sk-home" href="/"><strong>TryRaisins</strong> / Software engineer</a>
        <a class="sk-home sk-home-short" href="/">TryRaisins</a>
        <nav aria-label="Primary">
          <a href="/#play-desk">Work</a>
          <a href="/skills/" class="sk-nav-current" aria-current={current === 'library' ? 'page' : 'true'}>Agent skills</a>
          <a href="/#play-contact"><span class="sk-long">Get in touch</span><span class="sk-short">Contact</span></a>
        </nav>
      </header>
      <main id="sk-main">
        <slot />
      </main>
      <footer class="sk-footer">
        <p>Several skills are adapted from other authors and keep their original licenses, which are credited on each skill’s page.</p>
        <nav aria-label="Footer">
          <a class="sk-link" href="/">Back to my work</a>
          <a class="sk-link" href="https://github.com/tryraisins/MD_Files">Catalog on GitHub</a>
          <a class="sk-link" href="https://www.npmjs.com/package/yeknal">yeknal on npm</a>
        </nav>
      </footer>
      <p class="sk-sr" data-sk-status aria-live="polite"></p>
    </div>
    <script>
      import { mountRules } from '../scripts/notebook-rules';

      // Text written straight on the ruled paper sits on the rules. The white
      // cards and yellow sheets have no rules, so their text is left alone.
      const world = document.querySelector('.sk-world');
      if (world instanceof HTMLElement) {
        const written = ['.sk-home', '.sk-topbar nav a', '.sk-crumbs ol', '.sk-kicker', '.sk-h1', '.sk-h2', '.sk-h3', '.sk-lede', '.sk-facts', '.sk-sub', '.sk-results-bar p', '.sk-detail-meta', '.sk-body', '.sk-bullets li', '.sk-avoid', '.sk-requirements', '.sk-install-all', '.sk-footer p'];
        mountRules(world, { selector: written.map((s) => `${s}:not(.sk-sheet *):not(.sk-paper *)`).join(', '), paperFor: () => world });
      }
    </script>
  </body>
</html>

<style is:global>
  html { min-width: 320px; background: #f8f7f1; scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
  body { min-width: 320px; min-height: 100dvh; margin: 0; overflow-x: hidden; background: #f8f7f1; -webkit-tap-highlight-color: transparent; }
  ::selection { background: #315fe9; color: #fff; }
  .sk-world {
    --sk-paper: #ffffff;
    --sk-ink: #171719;
    --sk-muted: rgba(23,23,25,.72);
    --sk-red: #f05c45;
    --sk-blue: #315fe9;
    --sk-link: #2346b5;
    --sk-yellow: #f0ce4e;
    --sk-sheet: #f3d665;
    /* Headings, titles and labels are handwritten, as on the homepage; long
       instructions and prompts stay in print so they are easy to read and copy. */
    /* Same fallback rule as the homepage: readable handwriting, then print,
       never the generic `cursive` keyword. */
    --sk-hand: 'Caveat', 'Segoe Print', 'Chalkboard SE', 'Bradley Hand', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    /* One ruled line. Text written on the paper uses this height (or a multiple)
       and notebook-rules.ts lines up each first baseline with the rules. */
    --sk-rule: 36px;
    --sk-red-pen: #c4352b;
    --sk-section-font: var(--sk-hand);
    --sk-title-font: var(--sk-hand);
    --sk-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    --sk-margin: max(clamp(32px, 6vw, 96px), calc((100% - 1280px) / 2));
    /* Text starts this far inside the red margin rule, as on the homepage. */
    --sk-inset: calc(var(--sk-margin) + 40px);
    --sk-ease: cubic-bezier(0.23, 1, 0.32, 1);
    min-height: 100dvh;
    background-color: #f8f7f1;
    background-image:
      repeating-linear-gradient(to bottom, transparent 0, transparent 35px, rgba(52,110,204,.5) 35px, rgba(52,110,204,.5) 36px),
      linear-gradient(90deg, transparent 0 calc(var(--sk-margin) - 6px), rgba(214,62,56,.55) calc(var(--sk-margin) - 6px), rgba(214,62,56,.55) calc(var(--sk-margin) - 4.5px), transparent calc(var(--sk-margin) - 4.5px) calc(var(--sk-margin) - 1.5px), rgba(214,62,56,.55) calc(var(--sk-margin) - 1.5px), rgba(214,62,56,.55) var(--sk-margin), transparent var(--sk-margin));
    background-size: 100% 36px, 100% 100%;
    color: var(--sk-ink);
    font-family: 'DM Sans', sans-serif;
    font-size: 16px;
    line-height: 1.5;
  }
  .sk-world *, .sk-world *::before, .sk-world *::after { box-sizing: border-box; }
  .sk-world a { color: inherit; text-decoration: none; }
  .sk-world :is(a, button, input, select, textarea, summary):focus-visible { outline: 3px solid var(--sk-blue); outline-offset: 3px; }
  .sk-world :is(a, button, summary, label) { touch-action: manipulation; }
  :where(.sk-world) button { font: inherit; color: inherit; }
  .sk-world h1, .sk-world h2, .sk-world h3, .sk-world p { margin: 0; }
  .sk-world [hidden] { display: none !important; }
  .sk-skip { position: fixed; z-index: 20; top: 8px; left: 8px; min-height: 44px; padding: 0 14px; display: inline-flex; align-items: center; background: var(--sk-ink); color: var(--sk-paper) !important; font-size: 14px; transform: translateY(-150%); transition: transform 160ms var(--sk-ease); }
  .sk-skip:focus { transform: translateY(0); }
  .sk-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  .sk-topbar { padding: 28px var(--sk-margin) 0 var(--sk-inset); display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .sk-home { min-height: 48px; display: inline-flex; align-items: center; gap: .3em; color: rgba(23,24,29,.62); font: 500 22px/1.2 var(--sk-hand); }
  .sk-home strong { color: var(--sk-ink); font-weight: 700; }
  .sk-home-short, .sk-short { display: none !important; }
  .sk-topbar nav { display: flex; align-items: center; gap: 8px; }
  .sk-topbar nav a { min-height: 48px; padding: 0 12px; display: inline-flex; align-items: center; border: 1px solid transparent; font: 600 23px/1 var(--sk-hand); white-space: nowrap; }
  .sk-topbar nav a.sk-nav-current { border-color: var(--sk-ink); background: var(--sk-yellow); font-weight: 700; }

  .sk-section { padding: 0 var(--sk-margin) 0 var(--sk-inset); }
  .sk-kicker { color: var(--sk-red-pen); font: 600 28px/var(--sk-rule) var(--sk-hand); }
  .sk-h1 { font: 700 clamp(3.5rem, 7.4vw, 6.75rem)/.92 var(--sk-hand); line-height: round(nearest, .92em, var(--sk-rule)); text-wrap: balance; }
  .sk-h2 { font: 700 clamp(2.75rem, 4.6vw, 4rem)/1 var(--sk-section-font); line-height: round(nearest, 1em, var(--sk-rule)); }
  .sk-h3 { font: 700 clamp(2.4rem, 3.4vw, 3rem)/1 var(--sk-section-font); line-height: round(nearest, 1em, var(--sk-rule)); }
  .sk-lede { max-width: 46rem; color: rgba(23,23,25,.82); font-size: clamp(1.0625rem, 1.6vw, 1.3125rem); line-height: var(--sk-rule); }

  .sk-btn, .sk-btn-primary { min-height: 44px; padding: 0 16px; display: inline-flex; align-items: center; justify-content: center; gap: 8px; border: 1px solid var(--sk-ink); border-radius: 0; background: var(--sk-paper); color: var(--sk-ink); font: 600 14px/1.2 'DM Sans', sans-serif; text-align: center; cursor: pointer; user-select: none; }
  .sk-btn-primary { background: var(--sk-yellow); box-shadow: 3px 3px 0 var(--sk-ink); transition: transform 130ms var(--sk-ease), box-shadow 130ms var(--sk-ease); }
  .sk-btn-primary:active { transform: translate(2px, 2px); box-shadow: 1px 1px 0 var(--sk-ink); }
  .sk-btn:active { background: rgba(240,206,78,.62); }
  .sk-btn[aria-pressed='true'], .sk-btn[aria-expanded='true'] { background: var(--sk-ink); color: var(--sk-paper); }
  .sk-link { min-height: 44px; padding: 0 8px; display: inline-flex; align-items: center; border: 0; background: none; color: var(--sk-link) !important; font: 600 14px/1.2 'DM Sans', sans-serif; cursor: pointer; }
  .sk-link:active { background: rgba(240,206,78,.62); }

  .sk-sheet { position: relative; background: var(--sk-sheet); border: 2px solid var(--sk-ink); box-shadow: 6px 7px 0 var(--sk-red); }
  .sk-paper { background: var(--sk-paper); border: 1px solid var(--sk-ink); box-shadow: 4px 5px 0 rgba(23,23,25,.16); }
  .sk-meta { color: rgba(23,24,29,.68); font: 600 19px/1.2 var(--sk-hand); }
  .sk-code { font-family: var(--sk-mono); }

  .sk-prompt { width: 100%; min-height: 15rem; padding: 14px; border: 1px solid var(--sk-ink); border-radius: 0; background: var(--sk-paper); color: var(--sk-ink); font: 500 12.5px/1.55 var(--sk-mono); resize: vertical; }
  .sk-prompt.sk-prompt-select { border: 3px solid var(--sk-blue); }
  .sk-status { padding: 12px 14px; display: flex; gap: 10px; align-items: flex-start; border: 1px solid var(--sk-ink); background: var(--sk-paper); font-size: 14px; line-height: 1.45; }
  .sk-status::before { content: ''; width: 10px; height: 10px; margin-top: 5px; flex: none; border: 1px solid var(--sk-ink); border-radius: 50%; background: #24685e; }
  .sk-status[data-tone='error'] { border-color: #943614; background: #fff1ea; }
  .sk-status[data-tone='error']::before { border-radius: 0; background: #943614; transform: rotate(45deg); }

  .sk-footer { margin-top: 64px; padding: 40px var(--sk-margin) 56px var(--sk-inset); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px 32px; }
  .sk-footer p { max-width: 38rem; color: rgba(23,23,25,.72); font-size: 13px; line-height: var(--sk-rule); }
  .sk-footer nav { display: flex; flex-wrap: wrap; gap: 4px; margin-left: -8px; }

  @media (hover: hover) and (pointer: fine) {
    .sk-topbar nav a:not(.sk-nav-current):hover, .sk-link:hover, .sk-home:hover { background: rgba(240,206,78,.62); }
    .sk-btn:hover:not([aria-pressed='true']):not([aria-expanded='true']) { background: rgba(240,206,78,.62); }
    .sk-btn-primary:hover { transform: translate(-1px, -1px); box-shadow: 4px 4px 0 var(--sk-ink); }
  }
  @media (max-width: 760px) {
    .sk-home:not(.sk-home-short) { display: none; }
    .sk-home-short { display: inline-flex !important; color: var(--sk-ink); font-size: 24px; font-weight: 700; }
  }
  @media (max-width: 620px) {
    .sk-world { --sk-margin: 28px; --sk-inset: 44px; }
    /* The handwriting fallback is wider than Caveat, so the bar has to be able
       to wrap instead of pushing the whole page sideways on a phone. */
    .sk-topbar { padding: 20px 20px 0 var(--sk-inset); gap: 8px; flex-wrap: wrap; }
    .sk-topbar nav { gap: 2px; flex-wrap: wrap; }
    .sk-topbar nav a { padding: 0 7px; font-size: 21px; white-space: normal; }
    .sk-home-short { font-size: 22px; }
    .sk-long { display: none; }
    .sk-short { display: inline !important; }
  }
  @media (max-width: 360px) {
    .sk-home-short { font-size: 19px; }
    .sk-topbar nav a { padding: 0 5px; font-size: 18px; }
  }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    .sk-world *, .sk-world *::before, .sk-world *::after { transition-duration: .01ms !important; animation-duration: .01ms !important; }
  }
</style>
