    0% { clip-path: polygon(calc(50% - 30vmin) calc(50% - 18.7vmin), calc(50% - 34.8vmin) calc(50% - 36.3vmin), calc(50% - 13.7vmin) calc(50% - 42.7vmin), calc(50% + 11.7vmin) calc(50% - 36.5vmin), calc(50% + 29vmin) calc(50% - 30.2vmin), calc(50% + 34.9vmin) calc(50% - 21.8vmin), calc(50% + 38.4vmin) calc(50% - 14.4vmin), calc(50% + 49.1vmin) calc(50% - 6.1vmin), calc(50% + 51vmin) calc(50% + 6.4vmin), calc(50% + 44.9vmin) calc(50% + 16.8vmin), calc(50% + 40.7vmin) calc(50% + 25.4vmin), calc(50% + 30.5vmin) calc(50% + 31.8vmin), calc(50% + 13.1vmin) calc(50% + 40.8vmin), calc(50% - 12.7vmin) calc(50% + 39.6vmin), calc(50% - 31.9vmin) calc(50% + 33.2vmin), calc(50% - 41.6vmin) calc(50% + 26vmin), calc(50% - 43.5vmin) calc(50% + 16.3vmin), calc(50% - 35.2vmin) calc(50% + 4.4vmin), calc(50% - 41.1vmin) calc(50% - 5.1vmin), calc(50% - 36.8vmin) calc(50% - 13.8vmin)); transform: scale(.42) rotate(-10deg); }
    36% { clip-path: polygon(calc(25% - 16.7vmin) calc(25% - 9vmin), calc(35% - 16.3vmin) calc(25% - 20.8vmin), calc(45% - 2.8vmin) calc(25% - 21.8vmin), calc(55% + 9.5vmin) calc(25% - 16.9vmin), calc(65% + 15.8vmin) calc(25% - 14.9vmin), calc(75% + 17.5vmin) calc(25% - 9vmin), calc(75% + 23.6vmin) calc(35% - 8.2vmin), calc(75% + 26.7vmin) calc(45% - 5.6vmin), calc(75% + 26.4vmin) calc(55% + 1.7vmin), calc(75% + 20.7vmin) calc(65% + 7.3vmin), calc(75% + 23.3vmin) calc(75% + 16.5vmin), calc(65% + 11.4vmin) calc(75% + 19.1vmin), calc(55% + 2.3vmin) calc(75% + 19.5vmin), calc(45% - 9.8vmin) calc(75% + 15.6vmin), calc(35% - 11vmin) calc(75% + 13.8vmin), calc(25% - 19.5vmin) calc(75% + 9.5vmin), calc(25% - 22.2vmin) calc(65% + 9.1vmin), calc(25% - 21.2vmin) calc(55% + 6.4vmin), calc(25% - 16.7vmin) calc(45% + 1.3vmin), calc(25% - 14.6vmin) calc(35% - 2.8vmin)); transform: scale(.7) rotate(5deg); }
    68% { clip-path: polygon(calc(7% - 3.5vmin) calc(7% - 3.3vmin), calc(24.2% - 6.2vmin) calc(7% - 5.8vmin), calc(41.4% - 3.1vmin) calc(7% - 7.4vmin), calc(58.6% + 2vmin) calc(7% - 5.9vmin), calc(75.8% + 4.7vmin) calc(7% - 4.3vmin), calc(93% + 5.4vmin) calc(7% - 3.8vmin), calc(93% + 6.4vmin) calc(24.2% - 2.8vmin), calc(93% + 6.5vmin) calc(41.4% + 0.2vmin), calc(93% + 6.1vmin) calc(58.6% + 0.9vmin), calc(93% + 4.9vmin) calc(75.8% + 3.5vmin), calc(93% + 6.1vmin) calc(93% + 4.7vmin), calc(75.8% + 2.9vmin) calc(93% + 5.6vmin), calc(58.6% + 1vmin) calc(93% + 7vmin), calc(41.4% - 1.6vmin) calc(93% + 6vmin), calc(24.2% - 5.1vmin) calc(93% + 3.9vmin), calc(7% - 6.6vmin) calc(93% + 3.8vmin), calc(7% - 7.3vmin) calc(75.8% + 3vmin), calc(7% - 4.4vmin) calc(58.6% + 1.2vmin), calc(7% - 5.8vmin) calc(41.4% - 2vmin), calc(7% - 6.2vmin) calc(24.2% - 0.8vmin)); transform: scale(.95) rotate(-1.2deg); }
    100% { clip-path: polygon(0% 0%, 20% 0%, 40% 0%, 60% 0%, 80% 0%, 100% 0%, 100% 20%, 100% 40%, 100% 60%, 100% 80%, 100% 100%, 80% 100%, 60% 100%, 40% 100%, 20% 100%, 0% 100%, 0% 80%, 0% 60%, 0% 40%, 0% 20%); transform: scale(1) rotate(0deg); }
  }
  @keyframes boot-relax {
    0% { opacity: 1; }
    55% { opacity: .55; }
    100% { opacity: 0; }
  }
  @keyframes boot-relax-fast {
    0% { opacity: 1; }
    45% { opacity: .45; }
    80%, 100% { opacity: 0; }
  }
  @keyframes boot-shadow {
    0% { filter: drop-shadow(0 2.2vmin 2.6vmin rgba(23,23,25,.34)) drop-shadow(0 .3vmin .5vmin rgba(23,23,25,.28)); }
    70% { filter: drop-shadow(0 .8vmin 1.2vmin rgba(23,23,25,.16)) drop-shadow(0 0 0 rgba(23,23,25,0)); }
    100% { filter: drop-shadow(0 0 0 rgba(23,23,25,0)) drop-shadow(0 0 0 rgba(23,23,25,0)); }
  }
  @keyframes boot-leave {
    from { opacity: 1; }
    to { opacity: 0; visibility: hidden; pointer-events: none; }
  }
  @keyframes boot-fade {
    from { opacity: 1; }
    to { opacity: 0; visibility: hidden; pointer-events: none; }
  }
</style>
