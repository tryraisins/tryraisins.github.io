---
// Page-load paper starts as a flat ruled sheet on the desk, is crumpled into
// a ball, then opens into the page. The sheet is drawn here in CSS so it is in
// the first paint, covers WebGL startup and serves as the fallback. With
// reduced motion nothing moves, and an embedded still of the ball stands in.
// It must be the first element inside <body> so the bootstrap runs during parse,
// before anything beneath it can paint. State lives on
// <html data-boot="pending | revealing | done"> and is driven by
// src/scripts/boot-overlay.ts; the overlay's own data-paper is "loading" while
// the ball's shaders compile, "ball" while it runs and "flat" once it has
// opened. With JavaScript off data-boot is never set, so the sheet is never
// visible.
import ballStill from './boot-ball.webp?inline';
---

<script is:inline>
  (function () {
    var root = document.documentElement;
    root.setAttribute('data-boot', 'pending');
    root.setAttribute('data-boot-t0', String(performance.now()));
    // If the module never runs (blocked script, network failure) the sheet
    // must not hold the page hostage.
    setTimeout(function () {
      if (root.getAttribute('data-boot') !== 'pending') return;
      root.setAttribute('data-boot', 'done');
      var sheet = document.getElementById('boot-overlay');
      if (sheet) sheet.remove();
      document.dispatchEvent(new Event('boot:done'));
    }, 8000);
  })();
</script>

<div class="boot" id="boot-overlay" data-boot-overlay style={`--boot-ball-still: url(${ballStill})`}>
  <p class="boot-status" role="status">Loading</p>
</div>

<script>
  import { initBootOverlay } from '../scripts/boot-overlay';
  import { mountPaperBall } from '../scripts/paper-ball';
  mountPaperBall();
  void initBootOverlay();
</script>

<style>
  .boot {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 1000;
    overflow: hidden;
    background: #e9e6da;
  }
  :global(html[data-boot='pending']) .boot,
  :global(html[data-boot='revealing']) .boot { display: block; }

  /* Show the flat sheet immediately while WebGL prepares. It is the same
     ruled paper paper-ball.ts draws (paperTexture), so the canvas takes over
     without a jump. */
  .boot::after {
    --margin: max(min(max(32px, 6vw), 96px), (100vw - 1280px) / 2);
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background:
      linear-gradient(90deg, transparent calc(var(--margin) - 6px), rgba(214,62,56,.55) calc(var(--margin) - 6px) calc(var(--margin) - 4.5px), transparent calc(var(--margin) - 4.5px) calc(var(--margin) - 1.5px), rgba(214,62,56,.55) calc(var(--margin) - 1.5px) var(--margin), transparent var(--margin)),
      repeating-linear-gradient(to bottom, transparent 0 35px, rgba(52,110,204,.5) 35px 36px),
      #f1f0ea; /* #f8f7f1 under the texture's grain */
  }
  @media (max-width: 620px) { .boot::after { --margin: 28px; } }
  /* Reduced motion: the ball, still. */
  @media (prefers-reduced-motion: reduce) {
    .boot::after { background: #e9e6da var(--boot-ball-still) center / calc((min(100vw, 100vh) * .34 + 80px) * 1.4) no-repeat; }
  }
  .boot:is([data-paper='ball'], [data-paper='flat'])::after { animation: boot-still-out 180ms linear forwards; }
  @keyframes boot-still-out { to { opacity: 0; visibility: hidden; } }

  /* The ball has opened out, still creased: fade onto the page beneath. Keep
     the 400ms in step with TIMING.fade in boot-overlay.ts. The overlay stops
     taking pointer events with the fade, so a busy main thread cannot leave an
     invisible sheet over the page. */
  .boot[data-paper='flat'] { animation: boot-fade 400ms linear forwards; }

  /* No ball (reduced motion or no WebGL2): what is showing fades once. */
  :global(html[data-boot='revealing']) .boot:not([data-paper]) { animation: boot-fade 150ms linear forwards; }

  .boot-status { position: absolute; width: 1px; height: 1px; margin: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  .boot :global(.boot-ball) { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  /* The ball's contact shadow on the desk, sized and faded by paper-ball.ts. */
  .boot :global(.boot-ball-shadow) {
    position: absolute;
    left: calc(50% + var(--ball) * .1);
    top: calc(50% + var(--ball) * .34);
    width: calc(var(--ball) * 1.25);
    height: calc(var(--ball) * .5);
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(40,34,24,.55), rgba(40,34,24,.22) 55%, rgba(40,34,24,0));
    filter: blur(6px);
    opacity: 0;
    pointer-events: none;
  }

  @keyframes boot-fade {
    from { opacity: 1; }
    to { opacity: 0; visibility: hidden; pointer-events: none; }
  }
</style>
